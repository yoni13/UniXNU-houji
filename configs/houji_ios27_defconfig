# Stage 0 (iOS 27.2.1): arm64e kernel, UEFI -> UniXNU -> payload -> DarwinBoot -> verbose kernel from RAM.
# Storage, display and GPU stay off until each earlier stage shows its documented output.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
# CONFIG_XNU_NATIVE_UFS is not set
# Source storage (board package: NativeUfs + the public IOBlockStorageDevice) authenticates the root windows block by block;
# the kernel accepts the read-only OS root only when that binding confirms the mounted device.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
# launchd's ignition expects the SystemOS cryptex from iBoot: mount the owner-verified SystemOS window in its place.
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# Writable Data: the packed seed (scripts/make-data-seed-linux.py; local installation state, never committed) as a RAM disk,
# mounted at /private/var before launchd. RAM only: changes are lost at restart (storage writes are prohibited in this port).
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="8EACEB6E-F499-416E-9DD8-24D2194F9487"
# CONFIG_XNU_NATIVE_ADRENO is not set
# Display: UniXNU GopFramebuffer presents the firmware framebuffer as the original IOMobileFramebufferLegacy of 24B156
# (scripts/build-houji-display.py, scripts/legacy-display-24B156.json). It starts only with the offline-legacy-* arguments.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# The board package: debug console, SMMU route for its controller, reboot reason.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/houji-kit/libHoujiKit.a"
