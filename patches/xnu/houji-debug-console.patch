 {
+	{
+		/* houji: the debug console's RAM log keeps everything printed, also when no console device shows it. */
+		extern void native_houji_log_append(const char *, int);
+		native_houji_log_append(str, size);
+	}
 	if (disableConsoleOutput) {
 		return;
