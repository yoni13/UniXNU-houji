diff -ruN a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
--- a/osfmk/console/serial_console.c	2026-11-15 12:13:15.978785377 +0800
+++ b/osfmk/console/serial_console.c	2026-11-15 12:13:15.998237375 +0800
@@ -280,6 +280,11 @@
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
+	{
+		/* houji: the debug console's RAM log keeps everything, also what the screen does not show. */
+		extern void native_houji_log_append(const char *, int);
+		native_houji_log_append(c, size);
+	}
 	if (disableConsoleOutput) {
 		return;
 	}
diff -ruN a/pexpert/arm/pe_kprintf.c b/pexpert/arm/pe_kprintf.c
--- a/pexpert/arm/pe_kprintf.c	2026-11-15 12:13:15.982144566 +0800
+++ b/pexpert/arm/pe_kprintf.c	2026-11-15 12:13:15.998427754 +0800
@@ -162,6 +162,10 @@
 static void
 serial_putc_crlf(char c)
 {
+	{
+		extern void native_houji_log_append(const char *, int);
+		native_houji_log_append(&c, 1);
+	}
 	if (c == '\n') {
 		uart_putc('\r');
 	}
