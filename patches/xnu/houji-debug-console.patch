 {
+	{
+		/* houji: panic text takes this path (and then the serial path, which must not log it twice). */
+		extern void native_houji_log_unbuffered(char);
+		native_houji_log_unbuffered(c);
+	}
 	if (disableConsoleOutput) {
 		return;
 	}
