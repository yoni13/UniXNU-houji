+void NativeAdrenoVm::around(uint64_t addr,uint64_t out[8]) const
+{
+    for(unsigned i=0;i<8;++i)out[i]=0;
+    if(!attached_ || !mappings_ || !order_)return;
+    for(unsigned upper=0;upper<2;++upper) {
+        const size_t at=orderAt(upper,addr);
+        if(at<orderEnd(upper)) {
+            const Mapping &m=mappings_[order_[at]];
+            if(m.memory && (!out[5] || m.iova<out[4])) {
+                out[4]=m.iova;out[5]=m.memory->bytes();out[6]=m.handle;out[7]=m.kind|(uint64_t)m.permissions<<8;
+            }
+        }
+        if(at>orderBegin(upper)) {
+            const Mapping &m=mappings_[order_[at-1]];
+            if(m.memory && m.iova+m.memory->bytes()<=addr && (!out[1] || m.iova>out[0])) {
+                out[0]=m.iova;out[1]=m.memory->bytes();out[2]=m.handle;out[3]=m.kind|(uint64_t)m.permissions<<8;
+            }
+        }
+    }
+}
