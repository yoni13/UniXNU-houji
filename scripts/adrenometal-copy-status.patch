 enum Result { kOk = 0, kBadFrame, kBadScanout, kNoResource, kGpuFailed };
+// The copy's end. The runtime's waitUntilCompleted can return while the command buffer still reads Committed or Scheduled (its early
+// return paths), and taking that as a failure sent every such frame down the slow path (houji root125: 316 of 470 copies "failed", the
+// share of 60 Hz frames fell from 58% to 28%). Only Error fails; a buffer still in flight is waited for in 100 us steps, at most 20 ms.
+// The last failed copy's state for the kernel's report: MTLCommandBufferStatus << 8 | the low byte of its error code.
+inline std::atomic<uint32_t> gLastCopyDetail{0};
+static inline Result finishCopy(id<MTLCommandBuffer> commands) {
+    [commands waitUntilCompleted];
+    for (unsigned i = 0; i < 200 && commands.status != MTLCommandBufferStatusCompleted && commands.status != MTLCommandBufferStatusError; ++i) {
+        usleep(100);
+        [commands waitUntilCompleted];
+    }
+    if (commands.status == MTLCommandBufferStatusCompleted) return kOk;
+    gLastCopyDetail.store((uint32_t)commands.status << 8 | ((uint32_t)commands.error.code & 0xff), std::memory_order_relaxed);
+    return kGpuFailed;
+}
 
