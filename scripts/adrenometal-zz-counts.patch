new file mode 100644
--- /dev/null
+++ b/bridge/NativeMetalCounts.rs
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: MIT
+//! houji: boot argument `m2v-count=1` counts the bridge's draws, render encoders made and ended, and command buffer commits, with the
+//! time spent in each call, and every 100 ms or more (at a commit) notes the running totals and the device's shadow counts to the kernel's pass log
+//! (`tu_darwin_note`, kind 1, first word 0x4d32434e "M2CN"), which the console prints (`notes`). For the cost of one draw and the
+//! draws in a frame of backboardd's encoding thread (root297: Control Center frames of 17-30 ms of encoding).
+
+use std::sync::atomic::{AtomicI8, AtomicU64, Ordering};
+use std::time::Instant;
+
+pub const DRAW: usize = 0;
+pub const ENCODER: usize = 1;
+pub const END: usize = 2;
+pub const COMMIT: usize = 3;
+// The set calls, for the census of what changes between draws.
+pub const SET_BUFFER: usize = 4;
+pub const SET_OFFSET: usize = 5;
+pub const SET_BYTES: usize = 6;
+pub const SET_TEXTURE: usize = 7;
+pub const SET_SAMPLER: usize = 8;
+pub const SET_PIPELINE: usize = 9;
+pub const SET_DEPTH: usize = 10;
+pub const SET_VIEW: usize = 11;
+pub const SET_OTHER: usize = 12;
+const KINDS: usize = 13;
+
+static CALLS: [AtomicU64; KINDS] = [const { AtomicU64::new(0) }; KINDS];
+static NANOS: [AtomicU64; KINDS] = [const { AtomicU64::new(0) }; KINDS];
+// Encoding time by the class the runtime's census gave the draw or the pass (its first feature, or plain; `houji_census.rs`): a pass's
+// time is that of the calls made on it, from its encoder's making to its end.
+static DRAW_CLASS_NS: [AtomicU64; 16] = [const { AtomicU64::new(0) }; 16];
+static PASS_CLASS_NS: [AtomicU64; 16] = [const { AtomicU64::new(0) }; 16];
+static PASS_CLASS_N: [AtomicU64; 16] = [const { AtomicU64::new(0) }; 16];
+thread_local! {
+    static PASS_ACC: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+static LAST_NOTE_MS: AtomicU64 = AtomicU64::new(0);
+static ON: AtomicI8 = AtomicI8::new(-1);
+static PER_COMMIT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+// What the last commit's note saw: the totals of draws, encoders made, encoders ended and their nanoseconds.
+static AT_LAST_COMMIT: [AtomicU64; 4] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+
+fn on() -> bool {
+    let known = ON.load(Ordering::Relaxed);
+    if known >= 0 {
+        return known == 1;
+    }
+    let mut text = [0u8; 1024];
+    let mut length = text.len() - 1;
+    // SAFETY: a nul-terminated name, and a buffer of `length` bytes the call writes at most.
+    let read = unsafe {
+        libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+    };
+    let args = &text[..length.min(text.len())];
+    // m2v-count=1: the totals every 100 ms; m2v-count=2: also each commit's own work (`per_commit`).
+    let mode = (read == 0)
+        .then(|| {
+            args.windows(11).enumerate().find_map(|(at, w)| {
+                (w.starts_with(b"m2v-count=") && (at == 0 || args[at - 1] == b' ')
+                    && matches!(args.get(at + 11), None | Some(&b' ') | Some(&0)))
+                    .then(|| w[10])
+            })
+        })
+        .flatten();
+    let on = matches!(mode, Some(b'1') | Some(b'2'));
+    PER_COMMIT.store(mode == Some(b'2'), Ordering::Relaxed);
+    ON.store(on as i8, Ordering::Relaxed);
+    metal2vulkan_runtime::houji_census::set_on(on);
+    on
+}
+
+/// houji milestone 2: whether the runtime's shelf of carried bind states is on (`houji_census::set_fast`), brought up to date at most
+/// every 50 ms at a commit: the console's `m2v fast N` sets the kernel's host name to `m2v-fast-N`; under any other name, boot argument
+/// `m2v-fast=1` (read once). The console can carry it in neither a sysctl of its own nor the boot arguments.
+pub fn fast_refresh() {
+    static BOOT: AtomicI8 = AtomicI8::new(-1);
+    static LAST_MS: AtomicU64 = AtomicU64::new(u64::MAX);
+    let now = start().elapsed().as_millis() as u64;
+    let last = LAST_MS.load(Ordering::Relaxed);
+    if last != u64::MAX && now.wrapping_sub(last) < 50 {
+        return;
+    }
+    LAST_MS.store(now, Ordering::Relaxed);
+    if BOOT.load(Ordering::Relaxed) < 0 {
+        let mut text = [0u8; 1024];
+        let mut length = text.len() - 1;
+        // SAFETY: a nul-terminated name, and a buffer of `length` bytes the call writes at most.
+        let read = unsafe {
+            libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+        };
+        let args = &text[..length.min(text.len())];
+        let on = read == 0
+            && args.windows(10).enumerate().any(|(at, w)| {
+                w == b"m2v-fast=1" && (at == 0 || args[at - 1] == b' ') && matches!(args.get(at + 10), None | Some(&b' ') | Some(&0))
+            });
+        BOOT.store(on as i8, Ordering::Relaxed);
+    }
+    let mut name = [0u8; 64];
+    // SAFETY: a buffer of `name.len()` bytes, which the call writes at most.
+    let read = unsafe { libc::gethostname(name.as_mut_ptr().cast(), name.len()) };
+    let on = match (read, &name[..11]) {
+        (0, b"m2v-fast-1\0") => true,
+        (0, b"m2v-fast-0\0") => false,
+        _ => BOOT.load(Ordering::Relaxed) == 1,
+    };
+    metal2vulkan_runtime::houji_census::set_fast(on);
+}
+
+fn start() -> Instant {
+    static START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+    *START.get_or_init(Instant::now)
+}
+
+/// Counts one call of `kind` and, when dropped, the time since it was made.
+pub struct Timed(Option<(usize, Instant)>);
+
+impl Timed {
+    pub fn new(kind: usize) -> Timed {
+        if !on() {
+            return Timed(None);
+        }
+        start();
+        Timed(Some((kind, Instant::now())))
+    }
+}
+
+impl Drop for Timed {
+    fn drop(&mut self) {
+        let Some((kind, at)) = self.0 else { return };
+        let took = at.elapsed().as_nanos() as u64;
+        CALLS[kind].fetch_add(1, Ordering::Relaxed);
+        NANOS[kind].fetch_add(took, Ordering::Relaxed);
+        use metal2vulkan_runtime::houji_census as census;
+        match kind {
+            COMMIT => {}
+            ENCODER => PASS_ACC.with(|a| a.set(took)),
+            END => {
+                let pass = PASS_ACC.with(|a| a.replace(0)) + took;
+                let class = (census::take_pass_class() as usize).min(15);
+                PASS_CLASS_NS[class].fetch_add(pass, Ordering::Relaxed);
+                PASS_CLASS_N[class].fetch_add(1, Ordering::Relaxed);
+            }
+            _ => {
+                PASS_ACC.with(|a| a.set(a.get() + took));
+                if kind == DRAW {
+                    let class = (census::take_draw_class() as usize).min(15);
+                    DRAW_CLASS_NS[class].fetch_add(took, Ordering::Relaxed);
+                }
+            }
+        }
+    }
+}
+
+type NoteFn = unsafe extern "C" fn(u32, *const u32, u32) -> bool;
+
+/// With `m2v-count=2`, after each commit: the commit's own work since the one before (calls are encoded in order on the encoding
+/// thread), as a note of first word 0x4342574b "CBWK": its time in microseconds on the swaps' clock (mach time), its draws, its render
+/// encoders, and the microseconds spent in draws, encoders made and ended. A frame's command buffers lie between two swaps.
+fn per_commit() {
+    let draws = CALLS[DRAW].load(Ordering::Relaxed);
+    let encoders = CALLS[ENCODER].load(Ordering::Relaxed);
+    let nanos = NANOS[DRAW].load(Ordering::Relaxed) + NANOS[ENCODER].load(Ordering::Relaxed) + NANOS[END].load(Ordering::Relaxed);
+    let draw_nanos = NANOS[DRAW].load(Ordering::Relaxed);
+    let d = draws - AT_LAST_COMMIT[0].swap(draws, Ordering::Relaxed);
+    let e = encoders - AT_LAST_COMMIT[1].swap(encoders, Ordering::Relaxed);
+    let n = nanos - AT_LAST_COMMIT[2].swap(nanos, Ordering::Relaxed);
+    let dn = draw_nanos - AT_LAST_COMMIT[3].swap(draw_nanos, Ordering::Relaxed);
+    static FUNC: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    // SAFETY: a nul-terminated name; Turnip, loaded by then, exports it.
+    let f = *FUNC.get_or_init(|| unsafe { libc::dlsym(libc::RTLD_DEFAULT, c"tu_darwin_note".as_ptr()) as usize });
+    if f == 0 {
+        return;
+    }
+    // SAFETY: mach_absolute_time has no preconditions; this device's timebase is 1/1 or 125/3 ns per tick, read once.
+    let ticks = unsafe { libc::mach_absolute_time() };
+    static TB: std::sync::OnceLock<(u32, u32)> = std::sync::OnceLock::new();
+    let (numer, denom) = *TB.get_or_init(|| {
+        let mut info = libc::mach_timebase_info { numer: 0, denom: 0 };
+        // SAFETY: writes the struct.
+        unsafe { libc::mach_timebase_info(&mut info) };
+        (info.numer.max(1), info.denom.max(1))
+    });
+    let us = (ticks as u128 * numer as u128 / denom as u128 / 1000) as u64;
+    let words = [0x4342574bu32, (us >> 32) as u32, us as u32, d as u32, e as u32, (n / 1000) as u32, (dn / 1000) as u32];
+    // SAFETY: `tu_darwin_note(kind, words, count)` reads `count` words.
+    unsafe {
+        let f: NoteFn = std::mem::transmute(f);
+        f(1, words.as_ptr(), words.len() as u32);
+    }
+}
+
+/// After a commit: every 100 ms or more, the totals and `device`'s shadow counts, noted to the kernel.
+pub fn note(device: &metal2vulkan_runtime::Device) {
+    if !on() {
+        return;
+    }
+    if PER_COMMIT.load(Ordering::Relaxed) {
+        per_commit();
+    }
+    let now = start().elapsed().as_millis() as u64;
+    let last = LAST_NOTE_MS.load(Ordering::Relaxed);
+    if now < last + 100 || LAST_NOTE_MS.compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed).is_err() {
+        return;
+    }
+    static FUNC: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    // SAFETY: a nul-terminated name; Turnip, loaded by then, exports it.
+    let f = *FUNC.get_or_init(|| unsafe { libc::dlsym(libc::RTLD_DEFAULT, c"tu_darwin_note".as_ptr()) as usize });
+    if f == 0 {
+        return;
+    }
+    let mut words = [0u32; 20];
+    words[0] = 0x4d32434e;
+    words[1] = now as u32;
+    for k in 0..4 {
+        words[2 + 2 * k] = CALLS[k].load(Ordering::Relaxed) as u32;
+        words[3 + 2 * k] = (NANOS[k].load(Ordering::Relaxed) / 1000) as u32;
+    }
+    // Why textures go through shadows (`shadow.rs`): an image copied in from and back to their bytes around the passes that use them.
+    let w = device.work_counts();
+    for (i, v) in [
+        w.shadowed_textures,
+        w.host_textures_in_place,
+        w.host_texture_shadows_render_target,
+        w.host_texture_shadows_refused_rows,
+        w.host_texture_shadows_refused_image,
+        w.host_texture_shadows_refused_pitch,
+        w.host_texture_shadows_refused_placement,
+        w.host_texture_shadows_check_failed + w.host_texture_shadows_check_pending + w.host_texture_shadows_unchecked,
+        w.shadow_copies_in_skipped_by_standing,
+        w.shadow_copies,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        words[10 + i] = v as u32;
+    }
+    // SAFETY: `tu_darwin_note(kind, words, count)` reads `count` words.
+    unsafe {
+        let f: NoteFn = std::mem::transmute(f);
+        f(1, words.as_ptr(), words.len() as u32);
+        census_notes(f, &w);
+    }
+}
+
+/// The census rows (marks "CNSP", "CNSD", "CNST", "CNSU", "CNSB"): the runtime's pass and draw counts by feature, the pipeline
+/// spread, the encoding microseconds by draw class and by pass class (with the passes of each), and the set calls with their time.
+fn census_notes(f: NoteFn, w: &metal2vulkan_runtime::WorkCounts) {
+    use metal2vulkan_runtime::houji_census as census;
+    let row = |mark: u32, values: &[u64]| {
+        let mut words = vec![mark];
+        words.extend(values.iter().take(29).map(|v| *v as u32));
+        // SAFETY: `tu_darwin_note(kind, words, count)` reads `count` words.
+        unsafe { f(1, words.as_ptr(), words.len() as u32) };
+    };
+    row(0x434e5350, &census::snapshot());
+    let mut draws = census::draw_snapshot().to_vec();
+    draws.extend(census::pipeline_spread());
+    row(0x434e5344, &draws);
+    let micros = |a: &[AtomicU64; 16]| a.iter().map(|v| v.load(Ordering::Relaxed) / 1000).collect::<Vec<u64>>();
+    row(0x434e5354, &micros(&DRAW_CLASS_NS));
+    let mut passes = micros(&PASS_CLASS_NS);
