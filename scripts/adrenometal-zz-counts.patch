diff --git a/bridge/NativeMetalCounts.rs b/bridge/NativeMetalCounts.rs
new file mode 100644
--- /dev/null
+++ b/bridge/NativeMetalCounts.rs
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: MIT
+//! houji: boot argument `m2v-count=1` counts the bridge's draws, render encoders made and ended, and command buffer commits, with the
+//! time spent in each call, and every 100 ms or more (at a commit) notes the running totals and the device's shadow counts to the kernel's pass log
+//! (`tu_darwin_note`, kind 1, first word 0x4d32434e "M2CN"), which the console prints (`notes`). For the cost of one draw and the
+//! draws in a frame of backboardd's encoding thread (root297: Control Center frames of 17-30 ms of encoding).
+
+use std::sync::atomic::{AtomicI8, AtomicU64, Ordering};
+use std::time::Instant;
+
+pub const DRAW: usize = 0;
+pub const ENCODER: usize = 1;
+pub const END: usize = 2;
+pub const COMMIT: usize = 3;
+
+static CALLS: [AtomicU64; 4] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+static NANOS: [AtomicU64; 4] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+static LAST_NOTE_MS: AtomicU64 = AtomicU64::new(0);
+static ON: AtomicI8 = AtomicI8::new(-1);
+
+fn on() -> bool {
+    let known = ON.load(Ordering::Relaxed);
+    if known >= 0 {
+        return known == 1;
+    }
+    let mut text = [0u8; 1024];
+    let mut length = text.len() - 1;
+    // SAFETY: a nul-terminated name, and a buffer of `length` bytes the call writes at most.
+    let read = unsafe {
+        libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+    };
+    let args = &text[..length.min(text.len())];
+    let found = read == 0
+        && args.windows(11).enumerate().any(|(at, w)| {
+            w == b"m2v-count=1" && (at == 0 || args[at - 1] == b' ') && matches!(args.get(at + 11), None | Some(&b' ') | Some(&0))
+        });
+    ON.store(found as i8, Ordering::Relaxed);
+    found
+}
+
+fn start() -> Instant {
+    static START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+    *START.get_or_init(Instant::now)
+}
+
+/// Counts one call of `kind` and, when dropped, the time since it was made.
+pub struct Timed(Option<(usize, Instant)>);
+
+impl Timed {
+    pub fn new(kind: usize) -> Timed {
+        if !on() {
+            return Timed(None);
+        }
+        start();
+        Timed(Some((kind, Instant::now())))
+    }
+}
+
+impl Drop for Timed {
+    fn drop(&mut self) {
+        let Some((kind, at)) = self.0 else { return };
+        CALLS[kind].fetch_add(1, Ordering::Relaxed);
+        NANOS[kind].fetch_add(at.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
+
+type NoteFn = unsafe extern "C" fn(u32, *const u32, u32) -> bool;
+
+/// After a commit: every 100 ms or more, the totals and `device`'s shadow counts, noted to the kernel.
+pub fn note(device: &metal2vulkan_runtime::Device) {
+    if !on() {
+        return;
+    }
+    let now = start().elapsed().as_millis() as u64;
+    let last = LAST_NOTE_MS.load(Ordering::Relaxed);
+    if now < last + 100 || LAST_NOTE_MS.compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed).is_err() {
+        return;
+    }
+    static FUNC: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    // SAFETY: a nul-terminated name; Turnip, loaded by then, exports it.
+    let f = *FUNC.get_or_init(|| unsafe { libc::dlsym(libc::RTLD_DEFAULT, c"tu_darwin_note".as_ptr()) as usize });
+    if f == 0 {
+        return;
+    }
+    let mut words = [0u32; 20];
+    words[0] = 0x4d32434e;
+    words[1] = now as u32;
+    for k in 0..4 {
+        words[2 + 2 * k] = CALLS[k].load(Ordering::Relaxed) as u32;
+        words[3 + 2 * k] = (NANOS[k].load(Ordering::Relaxed) / 1000) as u32;
+    }
+    // Why textures go through shadows (`shadow.rs`): an image copied in from and back to their bytes around the passes that use them.
+    let w = device.work_counts();
+    for (i, v) in [
+        w.shadowed_textures,
+        w.host_textures_in_place,
+        w.host_texture_shadows_render_target,
+        w.host_texture_shadows_refused_rows,
+        w.host_texture_shadows_refused_image,
+        w.host_texture_shadows_refused_pitch,
+        w.host_texture_shadows_refused_placement,
+        w.host_texture_shadows_check_failed + w.host_texture_shadows_check_pending + w.host_texture_shadows_unchecked,
+        w.shadow_copies_in_skipped_by_standing,
+        w.shadow_copies,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        words[10 + i] = v as u32;
+    }
+    // SAFETY: `tu_darwin_note(kind, words, count)` reads `count` words.
+    unsafe {
+        let f: NoteFn = std::mem::transmute(f);
+        f(1, words.as_ptr(), words.len() as u32);
+    }
+}
