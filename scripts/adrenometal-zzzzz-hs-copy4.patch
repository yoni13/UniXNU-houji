+; scanout_opaque4 (houji, boot argument hs bit 2): scanout_opaque four pixels a thread, one 16-byte load and store (the row's last
+; pixels when its width is not a multiple of 4 one at a time): a quarter of the threads and of the memory requests.
+;   kernel void scanout_opaque4(device const uint *src [[buffer(0)]], device uint *dst [[buffer(1)]], constant uint4 &p [[buffer(3)]],
+;                               uint2 gid [[thread_position_in_grid]])   gid.x counts groups of four pixels
+define void @scanout_opaque4(ptr addrspace(1) noundef readonly air-buffer-no-alias %src, ptr addrspace(1) noundef air-buffer-no-alias %dst, ptr addrspace(2) noundef readonly align 16 dereferenceable(16) air-buffer-no-alias %p, <2 x i32> noundef %gid) local_unnamed_addr #0 {
+entry:
+  %w = load i32, ptr addrspace(2) %p, align 16
+  %ph = getelementptr inbounds i32, ptr addrspace(2) %p, i64 1
+  %h = load i32, ptr addrspace(2) %ph, align 4
+  %pss = getelementptr inbounds i32, ptr addrspace(2) %p, i64 2
+  %ss = load i32, ptr addrspace(2) %pss, align 8
+  %pds = getelementptr inbounds i32, ptr addrspace(2) %p, i64 3
+  %ds = load i32, ptr addrspace(2) %pds, align 4
+  %gx = extractelement <2 x i32> %gid, i64 0
+  %y = extractelement <2 x i32> %gid, i64 1
+  %x = shl i32 %gx, 2
+  %inx = icmp ult i32 %x, %w
+  %iny = icmp ult i32 %y, %h
+  %in = and i1 %inx, %iny
+  br i1 %in, label %body, label %done
+
+body:
+  %x64 = zext i32 %x to i64
+  %y64 = zext i32 %y to i64
+  %ss64 = zext i32 %ss to i64
+  %srow = mul i64 %y64, %ss64
+  %si = add i64 %srow, %x64
+  %sp = getelementptr inbounds i32, ptr addrspace(1) %src, i64 %si
+  %ds64 = zext i32 %ds to i64
+  %drow = mul i64 %y64, %ds64
+  %di = add i64 %drow, %x64
+  %dp = getelementptr inbounds i32, ptr addrspace(1) %dst, i64 %di
+  %x3 = add i32 %x, 3
+  %full = icmp ult i32 %x3, %w
+  br i1 %full, label %vec, label %tail0
+
+vec:
+  %v = load <4 x i32>, ptr addrspace(1) %sp, align 4
+  %px = or <4 x i32> %v, <i32 -16777216, i32 -16777216, i32 -16777216, i32 -16777216>
+  store <4 x i32> %px, ptr addrspace(1) %dp, align 4
+  br label %done
+
+tail0:
+  %t0 = load i32, ptr addrspace(1) %sp, align 4
+  %u0 = or i32 %t0, -16777216
+  store i32 %u0, ptr addrspace(1) %dp, align 4
+  %x1 = add i32 %x, 1
+  %c1 = icmp ult i32 %x1, %w
+  br i1 %c1, label %tail1, label %done
+
+tail1:
+  %sp1 = getelementptr inbounds i32, ptr addrspace(1) %sp, i64 1
+  %dp1 = getelementptr inbounds i32, ptr addrspace(1) %dp, i64 1
+  %t1 = load i32, ptr addrspace(1) %sp1, align 4
+  %u1 = or i32 %t1, -16777216
+  store i32 %u1, ptr addrspace(1) %dp1, align 4
+  %x2 = add i32 %x, 2
+  %c2 = icmp ult i32 %x2, %w
+  br i1 %c2, label %tail2, label %done
+
+tail2:
+  %sp2 = getelementptr inbounds i32, ptr addrspace(1) %sp, i64 2
+  %dp2 = getelementptr inbounds i32, ptr addrspace(1) %dp, i64 2
+  %t2 = load i32, ptr addrspace(1) %sp2, align 4
+  %u2 = or i32 %t2, -16777216
+  store i32 %u2, ptr addrspace(1) %dp2, align 4
+  br label %done
+
+done:
+  ret void
+}
