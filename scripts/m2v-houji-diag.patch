diff --git a/crates/metal2vulkan-runtime/src/houji_diag.rs b/crates/metal2vulkan-runtime/src/houji_diag.rs
new file mode 100644
index 0000000..f402560
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/houji_diag.rs
@@ -0,0 +1,61 @@
+//! houji: diagnostics of the plugin's trace switch (`SHENG_DIAG`, which boot argument `gtr=1` or `diag=1` sets), in the render
+//! server alone: each shadow the shadow log names (`shadow_log.rs`) as a line of `m2v/shadows.txt`, and the render encoders opened
+//! (`CommandBuffer::render_command_encoder`) and opened again from a committed command buffer's log (`render/replay.rs`) in
+//! `m2v/opens.txt`. Without the switch nothing is counted or written.
+
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::OnceLock;
+
+const SHADOWS: &str = "/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/shadows.txt";
+const OPENS: &str = "/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/opens.txt";
+/// The most shadow lines written; the rest only counted.
+const MOST_LINES: u64 = 600;
+
+/// Whether the diagnostics are on: the switch set and this process the render server, read once.
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var_os("SHENG_DIAG").is_some()
+            && std::env::current_exe().ok().and_then(|p| p.file_name().map(|n| n == "backboardd")).unwrap_or(false)
+    })
+}
+
+static LINES: AtomicU64 = AtomicU64::new(0);
+static OPENED: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+
+fn millis() -> u128 {
+    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis()).unwrap_or(0)
+}
+
+/// A shadow the shadow log names, `text` its line: the first [`MOST_LINES`] into `m2v/shadows.txt` (the first of the process
+/// truncates it), each with its number and the wall clock in milliseconds.
+pub(crate) fn shadow_line(text: &str) {
+    let n = LINES.fetch_add(1, Ordering::Relaxed);
+    if n >= MOST_LINES {
+        return;
+    }
+    let file = std::fs::OpenOptions::new().create(true).write(true).append(n > 0).truncate(n == 0).open(SHADOWS);
+    if let Ok(mut file) = file {
+        let _ = writeln!(file, "{n} {} {text}", millis());
+    }
+}
+
+/// A render encoder opened (`again`: opened again from a committed command buffer's log): every 256th, the counts into
+/// `m2v/opens.txt`, with the shadows named so far.
+pub(crate) fn opened(again: bool) {
+    if !on() {
+        return;
+    }
+    OPENED[again as usize].fetch_add(1, Ordering::Relaxed);
+    let (fresh, replayed) = (OPENED[0].load(Ordering::Relaxed), OPENED[1].load(Ordering::Relaxed));
+    if (fresh + replayed) % 256 != 0 {
+        return;
+    }
+    let line = format!(
+        "opens fresh {fresh} again {replayed} shadows {} at {}\n",
+        LINES.load(Ordering::Relaxed),
+        millis()
+    );
+    let _ = std::fs::write(OPENS, line);
+}
