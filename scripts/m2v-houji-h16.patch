+    // houji: boot argument h16=1 (`metal2vulkan::HOUJI_H16`) changes the emitted code: its own build key, so a
+    // cache filled without it serves none of its pipelines, and the other way round.
+    if houji_h16() {
+        metal2vulkan::HOUJI_H16.store(true, std::sync::atomic::Ordering::Relaxed);
+        hash.update(b"houji h16\0");
+    }
