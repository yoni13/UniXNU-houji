+/// houji: boot argument `lb=1`, read once.
+fn houji_lb() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let mut text = [0u8; 1100];
+        let mut length = text.len() - 1;
+        // SAFETY: a nul-terminated name and a buffer of `length` bytes the call writes at most.
+        let read = unsafe {
+            libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+        };
+        let args = &text[..length.min(text.len())];
+        read == 0
+            && args.windows(4).enumerate().any(|(at, w)| {
+                w == b"lb=1" && (at == 0 || args[at - 1] == b' ') && matches!(args.get(at + 4), None | Some(&b' ') | Some(&0))
+            })
+    })
+}
+
+/// houji (`lb=1`): `sampled`, the samples of the texture at `slot` through one sampler, with the
+/// computed level of detail `SampledLevels::lod_word` names taken as the explicit constant it is
+/// for this draw: every computed one of them is the `f32` at byte `b` of the stage's buffer slot
+/// `s`, and the draw binds there the bytes a `set*Bytes` call copied (`ArgumentTable::bytes`, a
+/// copy no later write of the caller's memory or any command reaches), `b + 4` within the call's
+/// length, the value finite. Else `sampled` as it is, its level of detail computed, which
+/// `SampledLevels::level` bounds by the sampler alone. The value then takes the sampler's bias,
+/// clamps and mipmap mode in `SampledLevels::level` as any constant does, a linear mipmap mode's
+/// fractional level reaching the level past it.
+fn houji_lod_word(stages: &Stages<'_>, slot: SlotRef, sampled: &SampledLevels) -> SampledLevels {
+    let mut out = *sampled;
+    let Some(word) = sampled.lod_word else {
+        return out;
+    };
+    if !sampled.computed || !houji_lb() {
+        return out;
+    }
+    let (s, b) = ((word >> 32) as u32, (word & 0xffff_ffff) as u32);
+    let Some(table) = stage_table(stages, slot.stage) else {
+        return out;
+    };
+    let Some(bytes) = table.bytes.get(&s) else {
+        return out;
+    };
+    if table.buffers.contains_key(&s) || u64::from(b) + 4 > u64::from(bytes.len) {
+        return out;
+    }
+    let Some(bits) = bytes.region.read_u32_at(u64::from(b)) else {
+        return out;
+    };
+    let lod = f32::from_bits(bits);
+    if !lod.is_finite() {
+        return out;
+    }
+    let highest = sampled.highest_lod().map_or(lod, |c| if c.is_nan() { f32::NAN } else { c.max(lod) });
+    if !highest.is_finite() {
+        return out;
+    }
+    out.highest_lod_bits = Some(highest.to_bits());
+    out.computed = false;
+    out.lod_word = None;
+    crate::houji_diag::lod_word_taken();
+    out
+}
+
+/// houji (the trace switch's refusal line): for `sampled`, the writes of the draw's plan that bind
+/// the texture at `slot` (combined, and with which sampler source), whether a constexpr one pairs with
+/// the samples' sampler (its immutable sampler's LOD clamps and mipmap mode), and where the bytes word
+/// `SampledLevels::lod_word` names stands: bound as bytes or as a buffer at its slot, the call's
+/// length, and the value.
+fn houji_explain(
+    _device: &Device,
+    (plan, compiled): (&BindingPlan, &RenderPipeline),
+    stages: &Stages<'_>,
+    slot: SlotRef,
+    sampled: &SampledLevels,
+) -> String {
+    let mut out = String::new();
+    for write in &plan.descriptors {
+        let WriteSource::CombinedImageSampler {
+            image: ImageSource::Texture { slot: of, .. },
+            sampler,
+        } = &write.source
+        else {
+            continue;
+        };
+        if *of != slot {
+            continue;
+        }
+        match sampler {
+            SamplerSource::Immutable => match immutable_sampler(compiled, write) {
+                Some((paired, desc)) => out.push_str(&format!(
+                    "immutable paired {} lod {}..{} bias {} mip {:?}; ",
+                    paired == sampled.sampler,
+                    desc.min_lod,
+                    desc.max_lod,
+                    desc.mip_lod_bias,
+                    desc.mipmap_mode
+                )),
+                None => out.push_str("immutable no-binding-sampler; "),
+            },
+            SamplerSource::Slot { slot: bound, .. } => out.push_str(&format!("runtime sampler slot {}; ", bound.index)),
+            _ => out.push_str("other sampler source; "),
+        }
+    }
+    if out.is_empty() {
+        out.push_str("no combined write for the slot; ");
+    }
+    if let Some(word) = sampled.lod_word {
+        let (s, b) = ((word >> 32) as u32, (word & 0xffff_ffff) as u32);
+        match stage_table(stages, slot.stage) {
+            None => out.push_str("no stage table"),
+            Some(table) => {
+                let buffer = table.buffers.get(&s).map(|(buffer, offset)| (buffer.length(), *offset));
+                match table.bytes.get(&s) {
+                    Some(bytes) => {
+                        let value = bytes.region.read_u32_at(u64::from(b)).map(f32::from_bits);
+                        out.push_str(&format!("bytes len {} word {b} value {value:?} buffer {buffer:?}", bytes.len));
+                    }
+                    None => out.push_str(&format!("no bytes at {s}, buffer (length, offset) {buffer:?}")),
+                }
+            }
+        }
+        out.push_str(&format!(" lb {}", houji_lb()));
+    }
+    out
+}
