+/// houji: where `l` is the `f32` the access lowering reads from a word of its stage's buffer slot
+/// at a constant Metal byte offset (`lower::access::emit`'s uniform words read): the bitcast of a
+/// load through an access chain `[0, off >> 2]` of the slot's `Resource` buffer global, `off` the
+/// slot's `select(RangeAtBindOffset(slot), c, residual + c)` (the residual `SlotBindOffset`, which
+/// the lowering adds to the pointer's offset; for `c` 0 the residual alone), its offset `c`
+/// constant and a multiple of 4: `slot << 32 | c`. `None` for any other form.
+fn buffer_word(m: &TypedModule, l: Value) -> BResult<Option<u64>> {
+    let def_of = |v: Value| -> Option<&Inst> {
+        m.blocks()
+            .iter()
+            .flat_map(|b| &b.insts)
+            .find(|n| n.result == Some(v))
+            .map(|n| &n.inst)
+    };
+    if !matches!(m.types().get(m.value(l)?.ty)?, Type::Float { width: 32 }) {
+        return Ok(None);
+    }
+    let Some(Inst::Convert {
+        op: crate::spirv::ir::ConvOp::Bitcast,
+        a: word,
+        ..
+    }) = def_of(l)
+    else {
+        return Ok(None);
+    };
+    if !matches!(m.types().get(m.value(*word)?.ty)?, Type::Int { width: 32, .. }) {
+        return Ok(None);
+    }
+    let Some(Inst::Load { ptr, .. }) = def_of(*word) else {
+        return Ok(None);
+    };
+    let Some(Inst::AccessChain { base, indices, .. }) = def_of(*ptr) else {
+        return Ok(None);
+    };
+    let [first, index] = indices[..] else {
+        return Ok(None);
+    };
+    if constant_u32(m, first)? != Some(0) {
+        return Ok(None);
+    }
+    let Some(global) = m.globals().iter().find(|g| g.value == *base) else {
+        return Ok(None);
+    };
+    let GlobalKind::Resource(slot) = &global.kind else {
+        return Ok(None);
+    };
+    if !matches!(slot.kind, ResourceKind::Buffer) {
+        return Ok(None);
+    }
+    let Some(Inst::Binary {
+        op: BinOp::ShiftRightLogical,
+        a: off,
+        b: two,
+        ..
+    }) = def_of(index)
+    else {
+        return Ok(None);
+    };
+    if constant_u32(m, *two)? != Some(2) {
+        return Ok(None);
+    }
+    let Some(Inst::Select { cond, t, f }) = def_of(*off) else {
+        return Ok(None);
+    };
+    // The condition: the slot's own `RangeAtBindOffset` specialization.
+    let at_bind = match m.value(*cond)?.origin {
+        ValueOrigin::Const(c) => match &m.consts().get(c)?.kind {
+            ConstKind::Spec {
+                key: crate::pipeline::sym::SpecKey::RangeAtBindOffset(of),
+                ..
+            } => of.stage == slot.stage && of.index == slot.index,
+            _ => false,
+        },
+        _ => false,
+    };
+    if !at_bind {
+        return Ok(None);
+    }
+    let Some(c) = constant_u32(m, *t)? else {
+        return Ok(None);
+    };
+    if c % 4 != 0 {
+        return Ok(None);
+    }
+    // The other arm: the residual plus the same offset, or for offset 0 the residual alone (a
+    // push-constant load).
+    let residual = match def_of(*f) {
+        Some(Inst::Binary {
+            op: BinOp::IAdd,
+            a,
+            b,
+            ..
+        }) => {
+            if constant_u32(m, *b)? == Some(c) {
+                Some(*a)
+            } else if constant_u32(m, *a)? == Some(c) {
+                Some(*b)
+            } else {
+                None
+            }
+        }
+        _ if c == 0 => Some(*f),
+        _ => None,
+    };
+    let Some(residual) = residual else {
+        return Ok(None);
+    };
+    let Some(Inst::Load { ptr: pushed, .. }) = def_of(residual) else {
+        return Ok(None);
+    };
+    let Some(Inst::AccessChain { base: block, .. }) = def_of(*pushed) else {
+        return Ok(None);
+    };
+    let from_push = m
+        .globals()
+        .iter()
+        .any(|g| g.value == *block && matches!(g.kind, GlobalKind::PushBlock));
+    if !from_push {
+        return Ok(None);
+    }
+    Ok(Some(u64::from(slot.index) << 32 | u64::from(c)))
+}
