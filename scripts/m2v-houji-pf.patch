 /// Whether a pass of `layout` on `device`, rate-mapped where `rate_mapped` says, with the
 /// extended-range shadows `extended`, lets its first instance record inline (the module docs):
 /// else the first check it fails ([`NotInline`]).
+/// houji: boot argument `pf=1`, read once ([`opens_inline`]).
+fn houji_pf() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let mut text = [0u8; 1100];
+        let mut length = text.len() - 1;
+        // SAFETY: a nul-terminated name and a buffer of `length` bytes the call writes at most.
+        let read = unsafe {
+            libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+        };
+        let args = &text[..length.min(text.len())];
+        read == 0
+            && args.windows(4).enumerate().any(|(at, w)| {
+                w == b"pf=1" && (at == 0 || args[at - 1] == b' ') && matches!(args.get(at + 4), None | Some(&b' ') | Some(&0))
+            })
+    })
+}
