+        b'0'..=b'9' => Some(u32::from(c - b'0')),
+        b'a'..=b'f' => Some(u32::from(c - b'a' + 10)),
+        _ => None,
+    };
+    let value = match (got, name.starts_with(b"houji-tog-"), hex(name[10]), name[11], name[12]) {
+        (0, true, Some(high), 0, _) => high,
+        (0, true, Some(high), low, 0) => hex(low).map_or(0, |low| high << 4 | low),
+        _ => 0,
+    };
