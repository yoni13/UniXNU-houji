 /// Whether a pass of `layout` on `device`, rate-mapped where `rate_mapped` says, with the
 /// extended-range shadows `extended`, lets its first instance record inline (the module docs):
 /// else the first check it fails ([`NotInline`]).
+/// houji: the console's `tog N` toggles: the kernel's host name `houji-tog-X` (X one hex digit), read
+/// at most every 50 ms; 0 under any other name. Bit 0 is `pf` here; bits 1-3 are Turnip's (`tu_init_hw`).
+fn houji_toggles() -> u32 {
+    use std::sync::atomic::{AtomicU32, AtomicU64, Ordering::Relaxed};
+    static BASE: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+    static READ_MS: AtomicU64 = AtomicU64::new(0);
+    static VALUE: AtomicU32 = AtomicU32::new(0);
+    let now = BASE.get_or_init(std::time::Instant::now).elapsed().as_millis() as u64 + 1;
+    let read = READ_MS.load(Relaxed);
+    if read != 0 && now - read < 50 {
+        return VALUE.load(Relaxed);
+    }
+    let mut name = [0u8; 64];
+    // SAFETY: a buffer of `name.len() - 1` bytes the call writes at most, its last byte left nul.
+    let got = unsafe { libc::gethostname(name.as_mut_ptr().cast(), name.len() - 1) };
+    let value = match (got, name.starts_with(b"houji-tog-"), name[10], name[11]) {
+        (0, true, digit @ b'0'..=b'9', 0) => u32::from(digit - b'0'),
+        (0, true, digit @ b'a'..=b'f', 0) => u32::from(digit - b'a' + 10),
+        _ => 0,
+    };
+    VALUE.store(value, Relaxed);
+    READ_MS.store(now, Relaxed);
+    value
+}
+
+/// houji: boot argument `pf=1`, read once, or the console's toggle bit 0 ([`houji_toggles`]), at each
+/// encoder ([`opens_inline`]).
+fn houji_pf() -> bool {
+    houji_pf_boot() || houji_toggles() & 1 != 0
+}
+
+fn houji_pf_boot() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let mut text = [0u8; 1100];
+        let mut length = text.len() - 1;
+        // SAFETY: a nul-terminated name and a buffer of `length` bytes the call writes at most.
+        let read = unsafe {
+            libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+        };
+        let args = &text[..length.min(text.len())];
+        read == 0
+            && args.windows(4).enumerate().any(|(at, w)| {
+                w == b"pf=1" && (at == 0 || args[at - 1] == b' ') && matches!(args.get(at + 4), None | Some(&b' ') | Some(&0))
+            })
+    })
+}
