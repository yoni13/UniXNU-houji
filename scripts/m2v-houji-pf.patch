+/// houji: the console's `tog N` toggles: the kernel's host name `houji-tog-X` or `houji-tog-XY` (one or
+/// two hex digits), read at most every 50 ms; 0 under any other name. Bit 0 is `pf` here, bits 1-3
+/// Turnip's (`tu_init_hw`), bit 4 the begun-ahead primaries left unused (`CommandBuffer::encoder_primary`).
+pub(crate) fn houji_toggles() -> u32 {
+    use std::sync::atomic::{AtomicU32, AtomicU64, Ordering::Relaxed};
+    static BASE: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+    static READ_MS: AtomicU64 = AtomicU64::new(0);
+    static VALUE: AtomicU32 = AtomicU32::new(0);
+    let now = BASE.get_or_init(std::time::Instant::now).elapsed().as_millis() as u64 + 1;
+    let read = READ_MS.load(Relaxed);
+    if read != 0 && now - read < 50 {
+        return VALUE.load(Relaxed);
+    }
+    let mut name = [0u8; 64];
+    // SAFETY: a buffer of `name.len() - 1` bytes the call writes at most, its last byte left nul.
+    let got = unsafe { libc::gethostname(name.as_mut_ptr().cast(), name.len() - 1) };
