+/// houji milestone 2: [`input_attachments`] pushed onto `uses` in place, of no allocation: what a draw rebound that reads input
+/// attachments uses beyond its plan's, made of its pass as every step makes them (`render/draw_again/rebound.rs`).
+fn input_attachments_into(
+    layout: &PassLayout,
+    graphics: &GraphicsState,
+    uses: &mut crate::binding::CommandUses,
+) -> Result<usize, Error> {
+    for input in &graphics.input_attachments {
+        let color = layout
+            .colors
+            .get(input.color_index as usize)
+            .and_then(Option::as_ref)
+            .filter(|_| layout.fetch_inputs)
+            .filter(|_| input.input_attachment_index == input.color_index)
+            .ok_or_else(|| internal("an input attachment the pass does not read"))?;
+        let target = &color.target;
+        if !render_target::takes_input(target)? {
+            return Err(internal("an input attachment without its usage"));
+        }
+        uses.push(target.texture.image_use(
+            target.level..target.level + 1,
+            target.layer..target.layer + 1,
+            Access::new(
+                vk::PipelineStageFlags2::FRAGMENT_SHADER,
+                vk::AccessFlags2::INPUT_ATTACHMENT_READ,
+            ),
+            false,
+        )?);
+    }
+    Ok(graphics.input_attachments.len())
+}
