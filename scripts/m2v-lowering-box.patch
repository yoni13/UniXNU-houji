+    /// houji: put `carried`, which the opening render encoder's pass does not fit, on the shelf, newest first: the oldest, where
+    /// the shelf is full, let go to the device's spares.
+    pub(crate) fn shelve(&self, carried: Box<Carried>) {
+        let oldest = {
+            let mut state = self.state();
+            let shelf = &mut state.shelf;
+            let oldest = shelf[shelf.len() - 1].take();
+            shelf.rotate_right(1);
+            shelf[0] = Some(carried);
+            oldest
+        };
+        if let Some(oldest) = oldest {
+            crate::houji_census::shelf_count(crate::houji_census::SHELF_EVICTED, 1);
+            oldest.let_go(&self.0.device);
+        }
+    }
