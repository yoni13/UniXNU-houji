diff --git a/crates/metal2vulkan-runtime/src/houji_census.rs b/crates/metal2vulkan-runtime/src/houji_census.rs
new file mode 100644
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/houji_census.rs
@@ -0,0 +1,425 @@
+//! houji: the render passes and draws by the features they used, for the compositor fast path's census (which share of a render
+//! server's passes and draws a reduced path could take). Counted at each render pass's end, only while [`set_on`] holds (the bridge
+//! turns it on with boot argument `m2v-count=1` or `2`); read by [`snapshot`].
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+/// The features a pass may use, by index into the counts ([`snapshot`]); [`PLAIN`] is a pass of none, [`DRAWS`] and
+/// [`PLAIN_DRAWS`] its draw calls.
+pub const PASSES: usize = 0;
+pub const RATE_MAP: usize = 1;
+pub const SPLIT: usize = 2;
+pub const STENCIL_SHADOW: usize = 3;
+pub const DEPTH_STAND_IN: usize = 4;
+pub const IMAGEBLOCK: usize = 5;
+pub const TILE_DISPATCH: usize = 6;
+pub const EXECUTIONS: usize = 7;
+pub const PENDING: usize = 8;
+pub const REPLAY_LOG: usize = 9;
+pub const COLOR_GROUPS: usize = 10;
+pub const BARRIER_INSIDE: usize = 11;
+pub const REACHES_UNNAMED: usize = 12;
+pub const INPUT_ATTACHMENTS: usize = 13;
+pub const VISIBILITY: usize = 14;
+pub const PLAIN: usize = 15;
+pub const DRAWS: usize = 16;
+pub const PLAIN_DRAWS: usize = 17;
+pub const COUNTS: usize = 18;
+
+static ON: AtomicBool = AtomicBool::new(false);
+static COUNT: [AtomicU64; COUNTS] = [const { AtomicU64::new(0) }; COUNTS];
+
+/// Count from now on (or stop).
+pub fn set_on(on: bool) {
+    ON.store(on, Ordering::Relaxed);
+}
+
+pub(crate) fn on() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+/// One pass's end: the features it used (`features[i]` for each index from [`RATE_MAP`] to [`VISIBILITY`]) and its draw calls.
+pub(crate) fn pass(features: &[bool; 15], draws: usize) {
+    COUNT[PASSES].fetch_add(1, Ordering::Relaxed);
+    COUNT[DRAWS].fetch_add(draws as u64, Ordering::Relaxed);
+    let mut plain = true;
+    for (i, used) in features.iter().enumerate().skip(1) {
+        if *used {
+            COUNT[i].fetch_add(1, Ordering::Relaxed);
+            plain = false;
+        }
+    }
+    if plain {
+        COUNT[PLAIN].fetch_add(1, Ordering::Relaxed);
+        COUNT[PLAIN_DRAWS].fetch_add(draws as u64, Ordering::Relaxed);
+    }
+    let class = features.iter().skip(1).position(|u| *u).map_or(PLAIN as u8, |i| i as u8 + 1);
+    set_pass_class(class);
+}
+
+/// The counts so far.
+pub fn snapshot() -> [u64; COUNTS] {
+    std::array::from_fn(|i| COUNT[i].load(Ordering::Relaxed))
+}
+
+/// The features a draw may use, by index into the draw counts ([`draw_snapshot`]); [`D_PLAIN`] a draw of none, [`D_AGAIN`] one
+/// the encoder drew again with its Vulkan draw alone (`render/draw_again.rs`, the existing fast path).
+pub const D_DRAWS: usize = 0;
+pub const D_AGAIN: usize = 1;
+pub const D_REPLAY_LOG: usize = 2;
+pub const D_COLOR_GROUPS: usize = 3;
+pub const D_RATE_MAP: usize = 4;
+pub const D_REPLAYING: usize = 5;
+pub const D_REROUTING: usize = 6;
+pub const D_TESSELLATED: usize = 7;
+pub const D_MESHES: usize = 8;
+pub const D_SHADER_TESTS: usize = 9;
+pub const D_MEMORYLESS: usize = 10;
+pub const D_BARRIER: usize = 11;
+pub const D_REACHES_UNNAMED: usize = 12;
+pub const D_EXTENDED: usize = 13;
+pub const D_PLAIN: usize = 14;
+pub const D_SAME_PIPELINE: usize = 15;
+pub const D_COUNTS: usize = 16;
+
+static D_COUNT: [AtomicU64; D_COUNTS] = [const { AtomicU64::new(0) }; D_COUNTS];
+static PIPELINES: std::sync::Mutex<Option<std::collections::HashMap<usize, u64>>> = std::sync::Mutex::new(None);
+
+thread_local! {
+    /// The class of the last draw and pass this thread lowered: the index of its first feature, or the plain index.
+    static DRAW_CLASS: std::cell::Cell<u8> = const { std::cell::Cell::new(0) };
+    static PASS_CLASS: std::cell::Cell<u8> = const { std::cell::Cell::new(0) };
+    static LAST_PIPELINE: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+/// One draw: `features[i]` for each index from [`D_AGAIN`] to [`D_EXTENDED`], and its pipeline's identity.
+pub(crate) fn draw(features: &[bool; 14], pipeline: usize) {
+    D_COUNT[D_DRAWS].fetch_add(1, Ordering::Relaxed);
+    let mut class = D_PLAIN as u8;
+    for (i, used) in features.iter().enumerate().skip(1) {
+        if *used {
+            D_COUNT[i].fetch_add(1, Ordering::Relaxed);
+            if class == D_PLAIN as u8 {
+                class = i as u8;
+            }
+        }
+    }
+    if class == D_PLAIN as u8 {
+        D_COUNT[D_PLAIN].fetch_add(1, Ordering::Relaxed);
+    }
+    DRAW_CLASS.with(|c| c.set(class));
+    if LAST_PIPELINE.with(|p| p.replace(pipeline)) == pipeline {
+        D_COUNT[D_SAME_PIPELINE].fetch_add(1, Ordering::Relaxed);
+    }
+    if let Ok(mut map) = PIPELINES.lock() {
+        *map.get_or_insert_with(Default::default).entry(pipeline).or_insert(0) += 1;
+    }
+}
+
+/// The class of the last draw this thread lowered (its first feature's index, or [`D_PLAIN`]), then cleared to 0 (none).
+pub fn take_draw_class() -> u8 {
+    DRAW_CLASS.with(|c| c.replace(0))
+}
+
+/// The class of the last pass this thread ended (its first feature's index, or [`PLAIN`]), then cleared to 0 (none).
+pub fn take_pass_class() -> u8 {
+    PASS_CLASS.with(|c| c.replace(0))
+}
+
+pub(crate) fn set_pass_class(class: u8) {
+    PASS_CLASS.with(|c| c.set(class));
+    ENCODER_PIPELINES.with(|seen| seen.borrow_mut().clear());
+    FORGOT.with(|f| f.set(0));
+}
+
+/// The draw counts so far.
+pub fn draw_snapshot() -> [u64; D_COUNTS] {
+    std::array::from_fn(|i| D_COUNT[i].load(Ordering::Relaxed))
+}
+
+/// The distinct pipelines drawn so far, and how many of them, most drawn first, cover 50 %, 90 % and 99 % of the draws.
+pub fn pipeline_spread() -> [u64; 4] {
+    let Ok(map) = PIPELINES.lock() else { return [0; 4] };
+    let Some(map) = map.as_ref() else { return [0; 4] };
+    let mut counts: Vec<u64> = map.values().copied().collect();
+    counts.sort_unstable_by(|a, b| b.cmp(a));
+    let total: u64 = counts.iter().sum();
+    let cover = |share: u64| {
+        let mut sum = 0;
+        for (i, c) in counts.iter().enumerate() {
+            sum += c;
+            if sum * 100 >= total * share {
+                return i as u64 + 1;
+            }
+        }
+        counts.len() as u64
+    };
+    [counts.len() as u64, cover(50), cover(90), cover(99)]
+}
+
+/// houji milestone 2, the shelf of carried bind states (`render/carried.rs`, `command_buffer/mod.rs`): on while [`set_fast`] holds (the
+/// bridge sets it from boot argument `m2v-fast=1`, or the console's `m2v fast N` through `kern.houji_m2v_fast`, at a commit).
+static FAST: AtomicBool = AtomicBool::new(false);
+
+pub fn set_fast(on: bool) {
+    FAST.store(on, Ordering::Relaxed);
+}
+
+pub fn fast() -> bool {
+    FAST.load(Ordering::Relaxed)
+}
+
+/// The shelf's counts ([`shelf_snapshot`]): openings that took a shelved bind state of their pass's shape, openings that found none,
+/// shelved states pushed out by newer ones, let go by a call between encoders or the commit, and taken but refused as their reads
+/// changed (`CarryDropped::Under`).
+pub const SHELF_TAKEN: usize = 0;
+pub const SHELF_MISSED: usize = 1;
+pub const SHELF_EVICTED: usize = 2;
+pub const SHELF_LET_GO: usize = 3;
+pub const SHELF_UNDER: usize = 4;
+pub const SHELF_COUNTS: usize = 5;
+static SHELF: [AtomicU64; SHELF_COUNTS] = [const { AtomicU64::new(0) }; SHELF_COUNTS];
+
+pub(crate) fn shelf_count(which: usize, n: u64) {
+    SHELF[which].fetch_add(n, Ordering::Relaxed);
+}
+
+pub fn shelf_snapshot() -> [u64; SHELF_COUNTS] {
+    std::array::from_fn(|i| SHELF[i].load(Ordering::Relaxed))
+}
+
+/// houji milestone 2 dry run ("CNSX", [`cross_snapshot`]): each draw by its pipeline's place in its encoder (the same as the draw
+/// before, back to one an earlier draw of the encoder used, or its first use there) and path (drawn again or every step), and, for the
+/// first uses that took every step, whether a cross-frame cache keyed by pipeline and pass shape (key A) would have held them: the key
+/// seen in an earlier command buffer (within 100 ms), only earlier in the same one, and the key with the pass's attachments' textures
+/// and render area (key B), which tells whether the key reaches per-frame objects.
+pub const X_DRAWS: usize = 0;
+pub const X_SAME: usize = 1;
+pub const X_RETURN: usize = 2;
+pub const X_FIRST: usize = 3;
+pub const X_RETURN_AGAIN: usize = 4;
+pub const X_RETURN_FULL: usize = 5;
+pub const X_FIRST_AGAIN: usize = 6;
+pub const X_FIRST_FULL: usize = 7;
+pub const X_A_EARLIER: usize = 8;
+pub const X_A_RECENT: usize = 9;
+pub const X_B_EARLIER: usize = 10;
+pub const X_A_SAME_ONLY: usize = 11;
+pub const X_A_KEYS: usize = 12;
+pub const X_B_KEYS: usize = 13;
+pub const X_SAME_FULL: usize = 14;
+pub const X_A_NEVER: usize = 15;
+/// The same in passes that read their colors as input attachments (framebuffer fetch): their draws, returns, and returns that took
+/// every step.
+pub const X_FETCH_DRAWS: usize = 16;
+pub const X_FETCH_RETURN: usize = 17;
+pub const X_FETCH_RETURN_FULL: usize = 18;
+pub const X_COUNTS: usize = 19;
+static X: [AtomicU64; X_COUNTS] = [const { AtomicU64::new(0) }; X_COUNTS];
+
+/// Where a key was last seen: its command buffer and when (ms since the first).
+type Seen = std::collections::HashMap<(usize, u64, u64), (crate::ObjectId, u64)>;
+static SEEN_A: std::sync::Mutex<Option<Seen>> = std::sync::Mutex::new(None);
+static SEEN_B: std::sync::Mutex<Option<Seen>> = std::sync::Mutex::new(None);
+
+thread_local! {
+    /// The pipelines the encoder this thread lowers drew so far, cleared at its end ([`set_pass_class`]).
+    static ENCODER_PIPELINES: std::cell::RefCell<Vec<usize>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+fn x(which: usize) {
+    X[which].fetch_add(1, Ordering::Relaxed);
+}
+
+fn ms() -> u64 {
+    static START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+    START.get_or_init(std::time::Instant::now).elapsed().as_millis() as u64
+}
+
+/// A key's place: seen in an earlier command buffer (and within 100 ms), or only in this one; then noted as seen here and now.
+fn look(map: &std::sync::Mutex<Option<Seen>>, key: (usize, u64, u64), cb: crate::ObjectId, now: u64) -> (bool, bool, bool, bool) {
+    let Ok(mut map) = map.lock() else { return (false, false, false, true) };
+    let map = map.get_or_insert_with(Default::default);
+    let found = map.insert(key, (cb, now));
+    match found {
+        None => (false, false, false, true),
+        Some((at, when)) if at < cb => (true, now.saturating_sub(when) <= 100, false, false),
+        Some(_) => (false, false, true, false),
+    }
+}
+
+/// One draw for the dry run: its pipeline, its pass's shape hash (with the layers) and attachments' hash, its command buffer, and
+/// whether it was drawn again.
+pub(crate) fn cross(pipeline: usize, (shape, fetch): (u64, bool), targets: u64, cb: crate::ObjectId, again: bool) {
+    x(X_DRAWS);
+    let place = ENCODER_PIPELINES.with(|seen| {
+        let mut seen = seen.borrow_mut();
+        let place = match seen.iter().position(|p| *p == pipeline) {
+            Some(at) if at + 1 == seen.len() => X_SAME,
+            Some(_) => X_RETURN,
+            None => X_FIRST,
+        };
+        seen.retain(|p| *p != pipeline);
+        seen.push(pipeline);
+        place
+    });
+    x(place);
+    account_why(place, again);
+    if fetch {
+        x(X_FETCH_DRAWS);
+        if place == X_RETURN {
+            x(X_FETCH_RETURN);
+            if !again {
+                x(X_FETCH_RETURN_FULL);
+            }
+        }
+    }
+    match (place, again) {
+        (X_RETURN, true) => x(X_RETURN_AGAIN),
+        (X_RETURN, false) => x(X_RETURN_FULL),
+        (X_FIRST, true) => x(X_FIRST_AGAIN),
+        (X_FIRST, false) => x(X_FIRST_FULL),
+        (_, false) => x(X_SAME_FULL),
+        _ => {}
+    }
+    let now = ms();
+    let (a_earlier, a_recent, a_same, a_new) = look(&SEEN_A, (pipeline, shape, 0), cb, now);
+    let (b_earlier, _, _, b_new) = look(&SEEN_B, (pipeline, shape, targets), cb, now);
+    if a_new {
+        x(X_A_KEYS);
+    }
+    if b_new {
+        x(X_B_KEYS);
+    }
+    if place == X_FIRST && !again {
+        match (a_earlier, a_same) {
+            (true, _) => x(X_A_EARLIER),
+            (false, true) => x(X_A_SAME_ONLY),
+            _ => x(X_A_NEVER),
+        }
+        if a_recent {
+            x(X_A_RECENT);
+        }
+        if b_earlier {
+            x(X_B_EARLIER);
+        }
+    }
+}
+
+pub fn cross_snapshot() -> [u64; X_COUNTS] {
+    std::array::from_fn(|i| X[i].load(Ordering::Relaxed))
+}
+
+/// houji milestone 2, step 1: why a draw took every step, by its pipeline's place in its encoder ([`cross`]; rows "CNSW" and "CNSL").
+/// The kinds: no kept draw (the last call site that forgot it, [`forgot`], or a pipeline's draw set aside under another epoch, or
+/// none set aside), unlike the kept draw (which fields), a kept draw that does not rebind, its rebind stopped (where), other.
+pub(crate) const WHY_NO_KEPT: u8 = 1;
+pub(crate) const WHY_UNLIKE: u8 = 2;
+pub(crate) const WHY_NOT_REBINDS: u8 = 3;
+pub(crate) const WHY_STOPPED: u8 = 4;
+pub(crate) const WHY_OTHER: u8 = 5;
+/// [`WHY_STOPPED`]'s places in `draw_rebound`.
+pub(crate) const STOP_ROUTE: u32 = 0;
+pub(crate) const STOP_RESTATE: u32 = 1;
+pub(crate) const STOP_STALE: u32 = 2;
+pub(crate) const STOP_BRING_IN: u32 = 3;
+pub(crate) const STOP_REBIND: u32 = 4;
+/// [`forgot`]'s codes for a pipeline's return that found no draw set aside, or one of another epoch.
+pub(crate) const FORGOT_NONE_ASIDE: u32 = 1;
+pub(crate) const FORGOT_OTHER_EPOCH: u32 = 2;
+
+thread_local! {
+    static WHY: std::cell::Cell<(u8, u32)> = const { std::cell::Cell::new((0, 0)) };
+    /// The last call site that forgot the encoder's kept draw: its file's index * 100000 + its line, or a code above; 0 none since
+    /// the encoder's opening.
+    static FORGOT: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+}
+
+/// Why the draw being lowered takes every step.
+pub(crate) fn why(kind: u8, detail: u32) {
+    if on() {
+        WHY.with(|w| w.set((kind, detail)));
+    }
+}
+
+/// The kept draw forgotten at `at` (or a code).
+pub(crate) fn forgot(at: &std::panic::Location<'_>) {
+    if on() {
+        let file = match at.file().rsplit('/').next().unwrap_or("") {
+            "render.rs" => 1,
+            "draw_again.rs" => 2,
+            "rebound.rs" => 3,
+            "restated.rs" => 4,
+            "carried.rs" => 5,
+            "replay.rs" => 6,
+            _ => 9,
+        };
+        FORGOT.with(|f| f.set(file * 100000 + at.line().min(99999)));
+    }
+}
+
+pub(crate) fn forgot_code(code: u32) {
+    if on() {
+        FORGOT.with(|f| f.set(code));
+    }
+}
+
+/// Counts by place (same, return, first) and kind (1..=5); the unlike fields (pipeline, call, counts, index buffer, index offset,
+/// command buffer, under) and the stop places of the same and return draws.
+static WHY_COUNT: [AtomicU64; 15] = [const { AtomicU64::new(0) }; 15];
+static UNLIKE_BITS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+static STOPS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+static FORGOT_AT: std::sync::Mutex<Option<std::collections::HashMap<u32, u64>>> = std::sync::Mutex::new(None);
+
+fn account_why(place: usize, again: bool) {
+    let (kind, detail) = WHY.with(|w| w.replace((0, 0)));
+    if again || kind > 5 {
+        return;
+    }
+    let kind = if kind == 0 { WHY_OTHER } else { kind };
+    let row = match place {
+        X_SAME => 0,
+        X_RETURN => 1,
+        _ => 2,
+    };
+    WHY_COUNT[row * 5 + kind as usize - 1].fetch_add(1, Ordering::Relaxed);
+    if kind == WHY_NO_KEPT {
+        let code = FORGOT.with(|f| f.get());
+        if let Ok(mut map) = FORGOT_AT.lock() {
+            *map.get_or_insert_with(Default::default).entry(row as u32 * 1_000_000 + code).or_insert(0) += 1;
+        }
+    }
+    if row < 2 {
+        match kind {
+            WHY_UNLIKE => {
+                for (bit, count) in UNLIKE_BITS.iter().enumerate() {
+                    if detail & (1 << bit) != 0 {
+                        count.fetch_add(1, Ordering::Relaxed);
+                    }
+                }
+            }
+            WHY_STOPPED => {
+                STOPS[(detail as usize).min(4)].fetch_add(1, Ordering::Relaxed);
+            }
+            _ => {}
+        }
+    }
+}
+
+/// The "CNSW" row: the 15 place-and-kind counts, the 7 unlike fields, the 5 stop places.
+pub fn why_snapshot() -> Vec<u64> {
+    let load = |a: &[AtomicU64]| a.iter().map(|v| v.load(Ordering::Relaxed)).collect::<Vec<u64>>();
+    let mut row = load(&WHY_COUNT);
+    row.extend(load(&UNLIKE_BITS));
+    row.extend(load(&STOPS));
+    row
+}
+
+/// The "CNSL" row: the 14 commonest (place * 1000000 + forget code, count) pairs of the draws that found no kept draw.
+pub fn forgot_snapshot() -> Vec<u64> {
+    let Ok(map) = FORGOT_AT.lock() else { return Vec::new() };
+    let Some(map) = map.as_ref() else { return Vec::new() };
+    let mut pairs: Vec<(u32, u64)> = map.iter().map(|(k, v)| (*k, *v)).collect();
+    pairs.sort_unstable_by(|a, b| b.1.cmp(&a.1));
+    pairs.iter().take(14).flat_map(|(k, v)| [*k as u64, *v]).collect()
+}
