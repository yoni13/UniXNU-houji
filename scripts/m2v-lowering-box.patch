+/// houji: with boot argument `m2v-count=1`, the first 200 textures refused for shared rows noted to the kernel's pass log
+/// (`tu_darwin_note`, kind 1, first word 0x524f5753 "ROWS"; console `notes`): the descriptor's width and height, and the layout's
+/// offset, row pitch, row bytes and rows. Which textures go through shadows for their rows (root306: 138 of 140 shadows).
+fn houji_note_rows(layout: &BufferLayout, descriptor: &TextureDescriptor) {
+    use std::sync::atomic::{AtomicI8, AtomicU32, Ordering};
+    static ON: AtomicI8 = AtomicI8::new(-1);
+    static NOTED: AtomicU32 = AtomicU32::new(0);
+    if ON.load(Ordering::Relaxed) < 0 {
+        let mut text = [0u8; 1100];
+        let mut length = text.len() - 1;
+        // SAFETY: a nul-terminated name and a buffer of `length` bytes the call writes at most.
+        let read = unsafe {
+            libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+        };
+        let args = &text[..length.min(text.len())];
+        let on = read == 0 && args.windows(11).any(|w| w == b"m2v-count=1");
+        ON.store(on as i8, Ordering::Relaxed);
+    }
+    if ON.load(Ordering::Relaxed) != 1 || NOTED.fetch_add(1, Ordering::Relaxed) >= 200 {
+        return;
+    }
+    // SAFETY: a nul-terminated name; Turnip, loaded by then, exports it.
+    let f = unsafe { libc::dlsym(libc::RTLD_DEFAULT, c"tu_darwin_note".as_ptr()) };
+    if f.is_null() {
+        return;
+    }
+    let words: [u32; 8] = [
+        0x524f5753,
+        descriptor.width as u32,
+        descriptor.height as u32,
+        layout.offset as u32,
+        layout.row_pitch as u32,
+        layout.row_bytes as u32,
+        layout.rows as u32,
+        layout.slices as u32,
+    ];
+    // SAFETY: `tu_darwin_note(kind, words, count)` reads `count` words.
+    unsafe {
+        let note: unsafe extern "C" fn(u32, *const u32, u32) -> bool = std::mem::transmute(f);
+        note(1, words.as_ptr(), words.len() as u32);
+    }
+}
