+    pub(crate) fn shelve(&self, carried: Box<Carried>) {
+        let oldest = {
+            let mut state = self.state();
+            let shelf = &mut state.shelf;
+            let oldest = shelf[shelf.len() - 1].take();
+            shelf.rotate_right(1);
