+impl RenderLowering {
+    /// houji milestone 2: push the input attachments' uses of the encoder's pipeline state's draws in this pass onto `uses`, a
+    /// draw rebound's made again of its plan alone (`render/draw_again/rebound.rs`).
+    pub(super) fn houji_push_inputs(&self, uses: &mut crate::binding::CommandUses) -> Result<(), Error> {
+        let Some(RenderStateKind::Graphics(state)) = self.pipeline.as_ref().map(RenderPipelineState::kind) else {
+            return Ok(());
+        };
+        let graphics = &state.base().graphics;
+        if graphics.input_attachments.is_empty() {
+            return Ok(());
+        }
+        input_attachments_into(&self.layout, graphics, uses)?;
+        crate::houji_census::input_rebound();
+        Ok(())
+    }
+}
