+/// houji milestone 2: [`fitting`], with the shelf of `command_buffer` while `houji_census::fast` holds: a `carried` of another pass
+/// shape goes on the shelf in place of being let go, and the newest shelved bind state of this pass's shape is taken instead, where
+/// one is; so an encoder starts from the last one of its shape in the command buffer, whatever encoders of other shapes came between.
+/// The taken one is checked as the carried one is (`carried_fits`): what it read that changes with no call as it was.
+pub(super) fn shelved_fitting(
+    carried: Option<Box<Carried>>,
+    opening: &Opening,
+    command_buffer: &crate::command_buffer::CommandBuffer,
+    (device, samplers): (&Device, u64),
+) -> Option<Box<Carried>> {
+    use crate::houji_census as census;
+    if !census::fast() {
+        return fitting(carried, opening, (device, samplers));
+    }
+    let carried = match carried {
+        Some(carried) if same_pass(&carried, opening) => Some(carried),
+        Some(carried) => {
+            command_buffer.shelve(carried);
+            None
+        }
+        None => None,
+    };
+    let carried = carried.or_else(|| command_buffer.take_shelved(|c| same_pass(c, opening)));
+    let Some(carried) = carried else {
+        census::shelf_count(census::SHELF_MISSED, 1);
+        return None;
+    };
+    census::shelf_count(census::SHELF_TAKEN, 1);
+    match carried_fits(&carried, opening, samplers) {
+        Ok(()) => Some(carried),
+        Err(why) => {
+            census::shelf_count(census::SHELF_UNDER, 1);
+            device.shared().counts.kept_draw_carry_dropped(why);
+            carried.let_go(device);
+            None
+        }
+    }
+}
 
