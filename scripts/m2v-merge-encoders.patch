+/// (`tu_init_hw`), 16 us of GPU apart from the work (root410: 140 primaries a frame, 1.71 ms). Off after a merged encoder could not
+/// keep its place ([`MERGE_VIOLATION`]).
+pub(crate) fn merge() -> bool {
+    use std::sync::atomic::AtomicI8;
+    static ON: AtomicI8 = AtomicI8::new(-1);
+    if ON.load(Ordering::Relaxed) < 0 {
+        let mut text = [0u8; 1100];
+        let mut length = text.len() - 1;
+        // SAFETY: a nul-terminated name and a buffer of `length` bytes the call writes at most.
+        let read = unsafe {
+            libc::sysctlbyname(c"kern.bootargs".as_ptr(), text.as_mut_ptr().cast(), &mut length, std::ptr::null_mut(), 0)
+        };
+        let args = &text[..length.min(text.len())];
+        let on = read == 0
+            && args.windows(4).enumerate().any(|(at, w)| {
+                w == b"mj=1" && (at == 0 || args[at - 1] == b' ') && matches!(args.get(at + 4), None | Some(&b' ') | Some(&0))
+            });
+        ON.store(on as i8, Ordering::Relaxed);
+    }
+    ON.load(Ordering::Relaxed) == 1 && !MERGE_OFF.load(Ordering::Relaxed)
