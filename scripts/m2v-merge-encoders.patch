+/// The merge counts ([`merge_count`]): encoders merged; encoders not merged because the command buffer had no open tail (its first
+/// encoder, or the tail closed), a batch boundary since (an event's wait or signal, a host step), a resource state encoder, the
+/// previous part not plain (a segment, sparse updates, ASTC twin writes), the device (its completed work made visible by a barrier, or
+/// held depths), a predicated loop's laying (a render encoder's counted as it asks, `EncoderCore::join_candidate`); merged encoders that could not keep
+/// their place at their end (a segment, a continuation, a part left out: the command buffer is abandoned and merging stops); merged
+/// parts failed, refused or encoded again after their end (their commands still in the shared primary); merged parts whose batch
+/// planned a timestamp, a held depth's move or a completed-work barrier before them.
+pub(crate) const MERGE_JOINED: usize = 0;
+pub(crate) const MERGE_NO_TAIL: usize = 1;
+pub(crate) const MERGE_NO_BATCH: usize = 2;
+pub(crate) const MERGE_NO_KIND: usize = 3;
+pub(crate) const MERGE_NO_PREVIOUS: usize = 4;
+pub(crate) const MERGE_NO_DEVICE: usize = 5;
+pub(crate) const MERGE_NO_LAYING: usize = 6;
+pub(crate) const MERGE_VIOLATION: usize = 7;
+pub(crate) const MERGE_LATE: usize = 8;
+pub(crate) const MERGE_SUBMIT: usize = 9;
+const MERGE_COUNTS: usize = 10;
+const MERGE_NAMES: [&str; MERGE_COUNTS] =
+    ["joined", "no-tail", "batch", "kind", "previous", "device", "laying", "violation", "late", "submit"];
+static MERGE_N: [AtomicU64; MERGE_COUNTS] = [const { AtomicU64::new(0) }; MERGE_COUNTS];
+static MERGE_OFF: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn merge_count(which: usize) {
+    MERGE_N[which].fetch_add(1, Ordering::Relaxed);
+    if which == MERGE_VIOLATION {
+        MERGE_OFF.store(true, Ordering::Relaxed);
+    }
+    merge_note();
+}
+
+/// The counts, at most once a second, into merge.txt beside the render server's frames.trace (Turnip's lazy-aged.txt is there too),
+/// by the render server alone.
+fn merge_note() {
+    use std::sync::OnceLock;
+    use std::time::Instant;
+    static START: OnceLock<Instant> = OnceLock::new();
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    static RENDER_SERVER: OnceLock<bool> = OnceLock::new();
+    let server = *RENDER_SERVER.get_or_init(|| {
+        std::env::current_exe().ok().and_then(|p| p.file_name().map(|n| n == "backboardd")).unwrap_or(false)
+    });
+    if !server {
+        return;
+    }
+    let now = START.get_or_init(Instant::now).elapsed().as_millis() as u64 + 1000;
+    let last = LAST.load(Ordering::Relaxed);
+    if now < last + 1000 || LAST.compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed).is_err() {
+        return;
+    }
+    let mut line = String::from("merge");
+    for (name, n) in MERGE_NAMES.iter().zip(MERGE_N.iter()) {
+        line.push_str(&format!(" {name} {}", n.load(Ordering::Relaxed)));
+    }
+    line.push_str(if MERGE_OFF.load(Ordering::Relaxed) { " off\n" } else { "\n" });
+    let _ = std::fs::write("/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/merge.txt", line);
+}
