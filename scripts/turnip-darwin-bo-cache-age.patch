  * within a second of entering it, as freedreno's own BO cache keeps a freed BO (freedreno_bo_cache.c, fd_bo_cache_cleanup: "keep things
  * in cache for at least 1 second", at most once a second). Without the second rule the cache held every BO the render server ever freed
  * once the kernel stopped refusing allocations (untagged-7c2c611f: backboardd held 3099 MiB, the system's memory ran out). */
+/* houji: boot argument tu-bc=N keeps a freed BO for N seconds (1 to 60) instead of one, under a cap of 256 MiB that evicts the
+ * oldest first. With one second every animation started cold: actions a couple of seconds apart found the cache emptied, and
+ * their first frames paid hundreds of allocations, GPU and CPU maps (root197: 33-52 % hits; Search 491 kernel allocations,
+ * 520 GPU maps at 160 us each per run). Without the argument the cache keeps its one-second rule. */
+static unsigned
+darwin_cache_age_s(void)
+{
+   static int age = -1;
+   if (age < 0) {
+      unsigned value = 1;
+      char args[1024] = {};
+      size_t size = sizeof(args) - 1;
+      if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
+         for (const char *at = args; (at = strstr(at, "tu-bc=")) != NULL; at += 6) {
+            if (at != args && at[-1] != ' ')
+               continue;
+            const unsigned parsed = (unsigned)strtoul(at + 6, NULL, 10);
+            if (parsed >= 1 && parsed <= 60)
+               value = parsed;
+            break;
+         }
+      }
+      age = (int)value;
+   }
+   return (unsigned)age;
+}
