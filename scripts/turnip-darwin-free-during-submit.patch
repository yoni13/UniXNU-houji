+/* The end of a queue submission's kernel submissions (fence: its last one's, 0 when none was made). The last one to end resolves the
+ * pending records to its fence, or to the newest one when it made none. Lock order as darwin_bo_finish: retire->lock, then dw.lock. */
+static void
+darwin_submission_ended(struct tu_device *dev, uint32_t fence)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   pthread_mutex_lock(&dw.lock);
+   const bool last = --darwin_submitting == 0;
+   const uint32_t resolved = fence ? fence : dw.last_fence;
+   pthread_mutex_unlock(&dw.lock);
+   if (last) {
+      for (unsigned i = 0; i < retire->count; ++i) {
+         struct darwin_retired_bo *bo = &retire->entries[(retire->head + i) % retire->capacity];
+         if (bo->fence == DARWIN_FENCE_PENDING)
+            bo->fence = resolved;
+      }
+   }
+   pthread_mutex_unlock(&retire->lock);
+}
