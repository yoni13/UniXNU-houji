+ * reaches the packet (not when the RB has drained the work before it, as the pass ring's RB_DONE_TS stamps are), into an entry of
+ * its own ring with the pass ring sequence number it goes with and a tag: kind << 28 (1 a primary's head, before tu_init_hw, beside
+ * its mode 8 entry; 2 a primary's end, after its last packet, beside its mode 7 entry) | its command pool's address >> 4 (28
+ * bits). The ring goes to m2v/cpstamps.bin (16-byte entries: ticks, sequence, tag), at most every 0.5 s, by the render server. */
+/* houji: the console's "tog N" toggles: the kernel's host name houji-tog-X or houji-tog-XY (one or two hex digits), read at most
+ * every 50 ms; 0 under any other name. Bit 0 pf (metal2vulkan's inline_first), bit 1 C-lite both groups, bit 2 its group A alone,
+ * bit 3 its group B alone (tu_init_hw, tu_queue.cc), bit 4 metal2vulkan's begun-ahead primaries left unused (spares.rs). */
+#include <unistd.h>
+static uint32_t
+tu_houji_toggles(void)
+{
+   static uint32_t value;
+   static uint64_t read_ns;
+   const uint64_t now = os_time_get_nano();
+   if (now - p_atomic_read(&read_ns) < 50000000ull)
+      return p_atomic_read(&value);
+   char name[64] = {};
+   uint32_t v = 0;
+   if (!gethostname(name, sizeof(name) - 1) && !strncmp(name, "houji-tog-", 10) && name[10] && (!name[11] || !name[12])) {
+      for (unsigned i = 10; name[i]; i++) {
+         const char c = name[i];
