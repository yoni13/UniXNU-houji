+#define TU_HOUJI_IOVA_RING 65536
+struct tu_houji_iova_rec {
+   uint32_t seq, entries;
+   uint64_t first_iova, last_end;
+   uint32_t first_bo, last_bo;
+};
+static struct tu_houji_iova_rec tu_houji_iova_ring[TU_HOUJI_IOVA_RING];
+static uint32_t tu_houji_iova_at;
