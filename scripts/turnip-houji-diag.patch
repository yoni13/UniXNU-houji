+/* houji (the plugin's trace switch SHENG_DIAG, boot argument gtr=1 or diag=1; the render server alone): the fragment shaders the
+ * frame trace names as the costliest (tu_hash32 of the variant, as the pass records keep it) and every one of 400 instructions or
+ * more, at most 64: each one's ir3 statistics and disassembly appended to m2v/ir3.txt once, and the SPIR-V the stage was created from,
+ * where this creation has it, to m2v/spirv.bin once (a header "SPV0", its hash, its size in bytes, the entry point's name length and
+ * name, then the words). Diagnostics only: without the switch it returns at its first test. */
+#include "vk_shader_module.h"
+#include "util/simple_mtx.h"
+extern "C" int try_disasm_a3xx(const uint32_t *dwords, int sizedwords, int level, FILE *out, unsigned gpu_id);
+static void
+tu_houji_dump_fs(struct tu_device *dev, const VkPipelineShaderStageCreateInfo *info, const struct ir3_shader_variant *v)
+{
+   static const bool on = getenv("SHENG_DIAG") && getprogname() && !strcmp(getprogname(), "backboardd");
+   if (!on || !v || !v->bin)
+      return;
+   static const uint32_t wanted[] = {0x7ebccf52, 0x7642b2b4, 0xb0100a10, 0x241ef7ce, 0x7623f474, 0x5b50d467,
+                                     0xdf543221, 0xe6dfd790, 0x01165b63, 0x327aa9f3, 0x5eda5251, 0x2b0af9f8};
+   const uint32_t hash = tu_hash32(v->blake3_str);
+   bool want = v->info.instrs_count >= 400;
+   for (uint32_t w : wanted)
+      want |= hash == w;
+   if (!want)
+      return;
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static uint32_t seen[64];
+   static bool spirv_seen[64];
+   static unsigned seen_count;
+   static bool truncated;
+   simple_mtx_lock(&lock);
+   unsigned i = 0;
+   while (i < seen_count && seen[i] != hash)
+      i++;
+   const bool fresh = i == seen_count;
+   if (fresh && seen_count == ARRAY_SIZE(seen)) {
+      simple_mtx_unlock(&lock);
+      return;
+   }
+   if (fresh) {
+      seen[seen_count++] = hash;
+      FILE *f = fopen("/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/ir3.txt", truncated ? "a" : "w");
+      if (f) {
+         const struct ir3_info *n = &v->info;
+         fprintf(f, "== fs %08x %s instrs %u preamble %u nops %u mov %u cov %u stp %u ldp %u loops %u max_reg %d max_half_reg %d "
+                    "mergedregs %d constlen %u max_waves %d double_threadsize %d ss %u sy %u sstall %u systall %u last_baryf %u "
+                    "early_preamble %d sizedwords %u cat0-7 %u %u %u %u %u %u %u %u\n",
+                 hash, v->blake3_str, n->instrs_count, n->preamble_instrs_count, n->nops_count, n->mov_count, n->cov_count,
+                 n->stp_count, n->ldp_count, n->loops, n->max_reg, n->max_half_reg, v->mergedregs, n->constlen, n->max_waves,
+                 n->double_threadsize, n->ss, n->sy, n->sstall, n->systall, n->last_baryf, n->early_preamble, n->sizedwords,
+                 n->instrs_per_cat[0], n->instrs_per_cat[1], n->instrs_per_cat[2], n->instrs_per_cat[3], n->instrs_per_cat[4],
+                 n->instrs_per_cat[5], n->instrs_per_cat[6], n->instrs_per_cat[7]);
+         try_disasm_a3xx(v->bin, n->sizedwords, 0, f, fd_dev_gpu_id(&dev->physical_device->dev_id));
+         fprintf(f, "== end %08x\n", hash);
+         fclose(f);
+         truncated = true;
+      }
+   }
+   if (info && !spirv_seen[i]) {
+      const uint32_t *code = NULL;
+      uint32_t size = 0;
+      if (info->module != VK_NULL_HANDLE) {
+         VK_FROM_HANDLE(vk_shader_module, module, info->module);
+         code = (const uint32_t *) module->data;
+         size = module->size;
+      } else {
+         const VkShaderModuleCreateInfo *made = vk_find_struct_const(info->pNext, SHADER_MODULE_CREATE_INFO);
+         if (made) {
+            code = made->pCode;
+            size = (uint32_t) made->codeSize;
+         }
+      }
+      static bool spirv_truncated;
+      FILE *f = code && size ? fopen("/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/spirv.bin",
+                                     spirv_truncated ? "ab" : "wb") : NULL;
+      if (f) {
+         const char *name = info->pName ? info->pName : "";
+         const uint32_t head[4] = {0x30565053, hash, size, (uint32_t) strlen(name)};
+         fwrite(head, sizeof(head), 1, f);
+         fwrite(name, 1, head[3], f);
+         fwrite(code, 1, size, f);
+         fclose(f);
+         spirv_truncated = true;
+         spirv_seen[i] = true;
+      }
+   }
+   simple_mtx_unlock(&lock);
+}
