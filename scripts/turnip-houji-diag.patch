+      .last_end = last->bo ? last->bo->iova + last->offset + last->size : 0,
+      .first_bo = first->bo ? (uint32_t) first->bo->gem_handle : 0,
+      .last_bo = last->bo ? (uint32_t) last->bo->gem_handle : 0,
+   };
+   static const bool server = getprogname() && !strcmp(getprogname(), "backboardd");
+   static uint64_t written_ns;
+   if (server && !(at & 511)) {
+      const uint64_t now = os_time_get_nano();
+      if (now - p_atomic_read(&written_ns) >= 500000000ull) {
+         p_atomic_set(&written_ns, now);
+         if (FILE *f = fopen("/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/cbiova.bin", "wb")) {
+            fwrite(tu_houji_iova_ring, sizeof(tu_houji_iova_ring[0]), TU_HOUJI_IOVA_RING, f);
+            fclose(f);
+         }
+      }
+   }
