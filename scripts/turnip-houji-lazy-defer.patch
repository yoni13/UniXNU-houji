 /* Called under retire->lock. All fence polls are nonblocking. Failed/uncertain
  * releases retain the record and the IOVA; a busy BO is retried by a later sweep. */
+/* houji: boot argument hs=N, bit 3 (with tu_cmd_buffer.cc's use of it): a freed lazily allocated BO (a memoryless attachment's memory,
+ * at the GPU address its vkAllocateMemory reserved) never enters the BO cache, so it was unmapped as soon as the newest fence submitted
+ * at its free passed; Turnip's Darwin submissions name only command-stream BOs, so a command buffer recorded before the free and
+ * submitted after it read an unmapped address (the Control Center faults past every mapped BO, root362, root381). With the bit such a
+ * BO stays mapped tu-bc seconds after its free (the cache's age); only while those it keeps exceed 256 MiB does it give back the oldest,
+ * and none freed in the last 500 ms. Counts: freed, kept past their fence, released by age, by the cap, the most bytes kept, in
+ * lazy-aged.txt beside the render server's frames.trace at most once a second. */
+static uint64_t darwin_lazy_freed, darwin_lazy_kept, darwin_lazy_aged, darwin_lazy_capped, darwin_lazy_peak;
+static bool
+darwin_lazy_defer(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      char args[1100] = {};
+      size_t size = sizeof args - 1;
+      const char *at = sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0 ? args : NULL;
+      while (at && (at = strstr(at, "hs=")) && at != args && at[-1] != ' ') at += 3;
+      on = at && at[3] >= '0' && at[3] <= '9' && ((at[3] - '0') & 8);
+   }
+   return on > 0;
+}
+static void
+darwin_lazy_note(void)
+{
+   static uint64_t last_ns;
+   const uint64_t now = os_time_get_nano();
+   if (now - last_ns < 1000000000ull || strcmp(getprogname(), "backboardd"))
+      return;
+   last_ns = now;
+   FILE *f = fopen("/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/lazy-aged.txt", "w");
+   if (!f)
+      return;
+   fprintf(f, "lazy BOs freed %llu kept %llu released by age %llu by the cap %llu peak MiB %llu\n", (unsigned long long) darwin_lazy_freed,
+           (unsigned long long) darwin_lazy_kept, (unsigned long long) darwin_lazy_aged, (unsigned long long) darwin_lazy_capped,
+           (unsigned long long) (darwin_lazy_peak >> 20));
+   fclose(f);
+}
