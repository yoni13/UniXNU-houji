+/* houji: GPU work outside render passes, in the pass ring (tu_pass_ring_read) after the passes' modes 0-2, with SHENG_DIAG only (the
+ * plugin sets it from gpu-trace=1 or diag=1); without it nothing is recorded or emitted. Each entry is stamped like u_trace
+ * (CP_EVENT_WRITE7 RB_DONE_TS of the always-on counter) before and after the work, no wait added. Modes: 3 a compute dispatch (width,
+ * height, draws its grid in workgroups, 0 when indirect; kpx its local size x | y << 10 | z << 20; fs_hash the shader's blake3 first 32
+ * bits; colors 1 when indirect), 4 a transfer (colors its kind: 1 copy buffer, 2 copy image, 3 buffer to image, 4 image to buffer,
+ * 5 blit, 6 resolve, 7 fill buffer, 8 update buffer, 9 clear colour image, 10 clear depth/stencil image; width, height the image's
+ * extent; kpx the regions or ranges; bandwidth the bytes of a buffer transfer; format), 5 a cache flush outside a render pass
+ * (bandwidth its tu_cmd_flush_bits), 6 an event wait outside a render pass (draws the events), 7 a primary command buffer from its
+ * begin to its end (draws its queue family). */
+uint32_t tu_op_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs, uint8_t mode, uint8_t kind, uint32_t w, uint32_t h, uint32_t z,
+                     uint32_t kpx, uint32_t bandwidth, uint32_t hash, uint32_t format);
+void tu_op_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs, uint32_t seq);
+struct tu_op_scope {
