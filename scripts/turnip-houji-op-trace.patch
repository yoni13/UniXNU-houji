+/* houji: the counts alone, for a pass the trace does not note (tu_render_mode_stats counted only with SHENG_DIAG before). */
+static uint32_t
+tu_count_render_mode(struct tu_cmd_buffer *cmd, bool sysmem)
+{
+   const VkExtent2D extent = cmd->state.render_areas[0].extent;
+   const uint64_t kpx = (uint64_t) extent.width * extent.height / 1000;
+   const char *reason = cmd->state.rp.gmem_disable_reason;
+   const unsigned slot =
+      !sysmem ? 0 : reason && !strcmp(reason, "Autotune selected sysmem") ? 2 : 4;
+   p_atomic_inc(&tu_render_mode_counts[slot]);
+   p_atomic_add(&tu_render_mode_counts[slot + 1], kpx);
+   if (!sysmem) {
+      for (unsigned i = 0; i < cmd->state.pass->attachment_count; i++) {
+         const struct tu_image_view *iview = cmd->state.attachments[i];
+         if (iview && tu_attachment_unpadded(cmd, iview)) {
+            p_atomic_inc(&tu_render_mode_counts[6]);
+            break;
+         }
+      }
+   }
+   return 0;
+}
+
+uint32_t
+tu_op_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs, uint8_t mode, uint8_t kind, uint32_t w, uint32_t h, uint32_t z,
+            uint32_t kpx, uint32_t bandwidth, uint32_t hash, uint32_t format)
+{
+   if (!tu_pass_trace_on())
+      return 0;
+   const uint32_t seq = p_atomic_inc_return(&tu_pass_seq);
+   const uint64_t iova = tu_pass_ts_slot(cmd, seq);
+   if (!iova)
+      return 0;
+   struct tu_pass_rec rec = {};
+   rec.ns = tu_trace_clock_ns();
+   rec.seq = seq;
+   rec.width = MIN2(w, 0xffff);
+   rec.height = MIN2(h, 0xffff);
+   rec.draws = MIN2(z, 0xffff);
+   rec.mode = mode;
+   rec.colors = kind;
+   rec.kpx = kpx;
+   rec.bandwidth = bandwidth;
+   rec.fs_hash = hash;
+   rec.format = (uint16_t) format;
+   tu_pass_ring[seq % TU_PASS_RING] = rec;
+   if (cmd->device->physical_device->info->chip >= 7)
+      tu_pass_stamp<A7XX>(cs, iova);
+   else
+      tu_pass_stamp<A6XX>(cs, iova);
    return seq;
+}
+
+void
+tu_op_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs, uint32_t seq)
+{
+   if (!seq)
+      return;
+   struct tu_bo *bo = p_atomic_read(&tu_pass_ts_bo);
+   if (!bo || tu_pass_ts_dev != cmd->device)
+      return;
+   const uint64_t iova = bo->iova + (seq % TU_PASS_RING) * 16 + 8;
+   if (cmd->device->physical_device->info->chip >= 7)
+      tu_pass_stamp<A7XX>(cs, iova);
+   else
+      tu_pass_stamp<A6XX>(cs, iova);
+}
+
+/* The first 32 bits of a shader's blake3 string, its id in the pass ring. */
+static uint32_t
+tu_op_hash8(const char *s)
+{
+   uint32_t h = 0;
+   for (unsigned i = 0; s && i < 8 && s[i]; i++) {
+      const char c = s[i];
+      h = h << 4 | (uint32_t) (c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : 0);
+   }
+   return h;
 }
 
