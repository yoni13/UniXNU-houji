diff --git a/src/freedreno/vulkan/tu_image.cc b/src/freedreno/vulkan/tu_image.cc
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -20,6 +20,36 @@
 #include "vulkan/vulkan_core.h"
 
 #include "common/freedreno_lrz.h"
+
+#include <string.h>
+#include <sys/sysctl.h>
+
+/* houji: boot argument tt=1 lays a linear image over memory its owner laid out without the over-fetch rows and page rounding
+ * fdl6_layout gives every other image (fdl_image_params::unpadded), so an IOSurface's texture fits its pages and renders and samples
+ * in place: without it, every such texture whose height is not a multiple of 4 rows went through a shadow copied in at every pass
+ * (root354: 533 of them, 1.03 copies a pass, 7 billion texels in a window of five Control Center opens). Its GMEM loads and stores
+ * take draws and 2D blits over its texels alone (tu_attachment_unpadded), as before.
+ */
+static bool
+tu_houji_tight(void)
+{
+   static int tight = -1;
+   if (tight < 0) {
+      char args[1024] = {};
+      size_t size = sizeof(args) - 1;
+      bool on = false;
+      if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
+         for (const char *at = args; (at = strstr(at, "tt=")) != NULL; at += 3) {
+            if (at != args && at[-1] != ' ')
+               continue;
+            on = at[3] == '1' && (at[4] == ' ' || at[4] == 0);
+            break;
+         }
+      }
+      tight = on;
+   }
+   return tight;
+}
 #include "fdl/fd6_format_table.h"
 #include "fdl/freedreno_layout.h"
 #include "tu_buffer.h"
@@ -760,6 +790,12 @@
          .sparse = image->vk.create_flags &
             VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT,
          .force_disable_linear_fallback = force_disable_linear_fallback,
+         /* houji: the images tu_attachment_unpadded names, by the same test of the image (fdl6_layout_image adds its tile mode). */
+         .unpadded = tu_houji_tight() &&
+            (image->vk.tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT ||
+             (image->vk.external_handle_types &
+              (VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT |
+               VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT))),
          .plane = i,
       };
 
