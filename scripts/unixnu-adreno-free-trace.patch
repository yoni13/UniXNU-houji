+/* houji: the newest 256 buffer frees (handle, pid, mach time, KiB) and the last submission that named a missing buffer: its handle,
+ * whether an entry of that handle still existed (unmapped) or none did, and the matching free's time and size if the ring has it. */
+extern "C" {volatile uint64_t houji_adreno_frees[256][4];volatile uint32_t houji_adreno_free_count;
+            volatile uint64_t houji_adreno_missing[6];}
+static void noteFree(uint64_t handle,uint64_t kib)
+{
+    const uint32_t n=houji_adreno_free_count;
+    volatile uint64_t *row=houji_adreno_frees[n&255];
+    row[0]=handle;row[1]=(uint64_t)proc_selfpid();row[2]=mach_absolute_time();row[3]=kib;
+    houji_adreno_free_count=n+1;
+}
+static void noteMissing(uint64_t handle,bool unmapped)
+{
+    const uint64_t pid=(uint64_t)proc_selfpid(),now=mach_absolute_time();
+    houji_adreno_missing[0]=handle;houji_adreno_missing[1]=pid;houji_adreno_missing[2]=unmapped;houji_adreno_missing[3]=now;
+    houji_adreno_missing[4]=0;houji_adreno_missing[5]=0;
+    const uint32_t n=houji_adreno_free_count;
+    for(uint32_t i=0;i<256 && i<n;++i) {
+        volatile uint64_t *row=houji_adreno_frees[(n-1-i)&255];
+        if(row[0]==handle && row[1]==pid) {houji_adreno_missing[4]=now-row[2];houji_adreno_missing[5]=row[3];break;}
+    }
+}
