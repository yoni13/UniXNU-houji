+/* houji: submissions refused with anything but kIOReturnBusy (Turnip then loses its device: "submit failed"): count, last status,
+ * its pid, where it failed (1 fence wait, 2 buffer lookup, 3 the ring submit) and when (mach time). */
+extern "C" {volatile uint64_t houji_adreno_submit_errors[5];uint64_t mach_absolute_time(void);}
+static IOReturn noteSubmitError(IOReturn status,uint32_t where)
+{
+    if(status && status!=kIOReturnBusy) {
+        houji_adreno_submit_errors[0]=houji_adreno_submit_errors[0]+1;houji_adreno_submit_errors[1]=(uint32_t)status;
+        houji_adreno_submit_errors[2]=(uint64_t)proc_selfpid();houji_adreno_submit_errors[3]=where;
+        houji_adreno_submit_errors[4]=mach_absolute_time();
+    }
+    return status;
+}
