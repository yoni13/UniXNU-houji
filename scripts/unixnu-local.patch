+def archive_hash(path):
+    """Hash a static archive by its members' names and contents. Apple's archive writers leave uninitialized padding in the
+    __.SYMDEF index (ar and libtool -static -D alike), so identical objects give a different archive every run; the index and
+    the member dates do not reach the link."""
+    data = path.read_bytes()
+    if data[:8] != b'!<arch>\n':
+        return file_hash(path)
+    digest, at = hashlib.sha256(), 8
+    while at + 60 <= len(data):
+        header = data[at:at + 60]
+        name, size = header[:16].decode('ascii', 'replace').rstrip(), int(header[48:58])
+        body = data[at + 60:at + 60 + size]
+        if name.startswith('#1/'):
+            length = int(name[3:])
+            name, body = body[:length].rstrip(b'\0').decode('utf-8', 'replace'), body[length:]
+        if not name.startswith('__.SYMDEF'):
+            digest.update(name.encode() + b'\0' + hashlib.sha256(body).digest())
+        at += 60 + size + (size & 1)
+    return digest.hexdigest()
+
