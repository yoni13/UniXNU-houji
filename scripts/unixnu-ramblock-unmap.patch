+IOReturn NativeRamBlock::doUnmap(IOBlockStorageDeviceExtent *extents, UInt32 count, IOStorageUnmapOptions)
+{
+  if (!extents && count) return kIOReturnBadArgument;
+  if (!gate) return kIOReturnNotReady;
+  IOLockLock(gate);
+  if (!online) { IOLockUnlock(gate); return kIOReturnNotReady; }
+  uint64_t freed = 0;
+  if (unmapEnabled()) {
+    for (UInt32 e = 0; e < count; ++e) {
+      const uint64_t block = extents[e].blockStart, blocks = extents[e].blockCount;
+      if (!blocks || block >= capacity || blocks > capacity - block) continue;
+      // Whole pages inside the extent only; a partly covered page keeps its bytes (unmapped data has no defined content).
+      const uint64_t first = (block * 512 + 4095) / 4096, end = (block + blocks) * 512 / 4096;
+      for (uint64_t i = first; i < end; ++i) {
+        if (!sparse.pages[i]) continue;
+        IOFree(sparse.pages[i], 4096);
+        sparse.pages[i] = nullptr;
+        sparse.resident -= 4096;
+        ++freed;
+      }
+    }
+    native_ram_block_resident_bytes = sparse.resident;
+  }
+  IOLockUnlock(gate);
+  __atomic_fetch_add(&native_ram_block_unmapped_pages, freed, __ATOMIC_RELAXED);
+  __atomic_fetch_add(&native_ram_block_unmaps, 1, __ATOMIC_RELAXED);
+  return kIOReturnSuccess;
+}
