 // boot-arg vsync; a platform may answer otherwise (its display device's mode).
 extern "C" __attribute__((weak)) unsigned native_legacy_refresh_hz(void) {
     unsigned hz=0;PE_parse_boot_argn("vsync",&hz,sizeof(hz));return hz;
 }
+// Port the fixed-refresh publication used by the older houji framebuffer to
+// iOS 27's selected CADisplayTimer path. This does not claim physical vblank.
+static bool nativeLegacyVsyncPort() {
+    unsigned enabled=0;PE_parse_boot_argn("fb-vsync-port",&enabled,sizeof(enabled));return enabled==1;
+}
